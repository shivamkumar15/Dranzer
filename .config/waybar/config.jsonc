{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 32,
  "spacing": 2,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "hyprland/workspaces",
    "custom/hint",
    "custom/cava",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/media",
    "clock"
  ],
  "modules-right": [
    "custom/netspeed",
    "network",
    "backlight",
    "cpu",
    "memory",
    "battery",
    "pulseaudio",
    "custom/notification",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scrolling": false,
    "all-outputs": true,
    "sort-by-number": true,
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6]
    }
  },

  "custom/hint": {
    "format": "󰌌",
    "tooltip-format": "Keyboard shortcuts (Super+H)",
    "on-click": "~/.local/bin/bitbeast keybindings"
  },

  "custom/cava": {
    "exec": "~/.local/bin/waybar-cava.sh 10 10",
    "format": "{}",
    "tooltip": false,
    "restart-interval": 2
  },

  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "max-length": 40,
    "rewrite": {
      "": "󰖯 Desktop"
    }
  },

  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.local/bin/bitbeast-media",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M  %a %d}",
    "format-alt": "{:%A, %d %B %Y  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "~/.local/bin/bitbeast-power-popup"
  },

  "custom/netspeed": {
    "exec": "~/.local/bin/waybar-netspeed.sh",
    "format": "{}",
    "tooltip": false,
    "restart-interval": 2
  },

  "network": {
    "format": "󰤭",
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰤮 off",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-down": "brightnessctl set 5%-",
    "on-scroll-up": "brightnessctl set +5%"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 2,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C"
  },

  "load": {
    "format": " {load1}",
    "interval": 2
  },

  "disk": {
    "path": "/",
    "format": "󰋊 {percentage_used}%",
    "interval": 30,
    "tooltip-format": "{used} / {total}"
  },

  "custom/updates": {
    "format": "{}",
    "return-type": "json",
    "interval": 1800,
    "exec": "~/.local/bin/waybar-updates.sh",
    "tooltip": true,
    "on-click": "kitty -e bash -lc 'yay -Syu; read -n1 -p \"Press any key...\"'"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power toggle"
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth": "󰂰 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-en-us": "US",
    "format-ru": "RU",
    "format-de": "DE",
    "format-fr": "FR"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": "Session / power menu",
    "on-click": "~/.local/bin/bitbeast-power-popup"
  }
}
