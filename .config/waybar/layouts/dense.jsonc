{
  "height": 30,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "cpu",
    "temperature",
    "load",
    "memory",
    "custom/updates",
    "disk",
    "network",
    "custom/cava"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "custom/netspeed",
    "tray",
    "bluetooth",
    "backlight",
    "pulseaudio#mic",
    "pulseaudio",
    "battery",
    "hyprland/language",
    "clock",
    "custom/power"
  ],
  "clock": {
    "format": "{:%H:%M:%S  %a-%d-%m}",
    "format-alt": "{:%A, %d %B %Y}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "~/.local/bin/bitbeast-power-popup"
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "max-length": 36,
    "rewrite": { "": "󰖯 Desktop" }
  }
}
