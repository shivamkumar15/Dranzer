{
  "height": 34,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": [
    "hyprland/workspaces",
    "cpu",
    "memory",
    "network"
  ],
  "modules-center": [
    "clock",
    "custom/media"
  ],
  "modules-right": [
    "backlight",
    "pulseaudio",
    "battery",
    "tray",
    "custom/power"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d · %H:%M}",
    "interval": 1,
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "~/.local/bin/bitbeast-power-popup"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 2
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 2
  },
  "network": {
    "format": "󰤭",
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format": "{essid}",
    "on-click": "nm-connection-editor"
  }
}
