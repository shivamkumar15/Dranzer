{
  "height": 32,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cava",
    "custom/media"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "battery",
    "pulseaudio",
    "custom/power"
  ],
  "clock": {
    "format": "󰥔  {:%H:%M:%S}",
    "format-alt": "{:%A %d %B}",
    "interval": 1,
    "tooltip-format": "{:%Y-%m-%d}",
    "on-click": "~/.local/bin/bitbeast-power-popup"
  },
  "custom/cava": {
    "exec": "~/.local/bin/waybar-cava.sh 14 12",
    "format": "{}",
    "tooltip": false,
    "restart-interval": 2
  },
  "hyprland/workspaces": {
    "disable-scrolling": false,
    "all-outputs": true,
    "sort-by-number": true,
    "format": "{icon}",
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "◉"
    },
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  }
}
