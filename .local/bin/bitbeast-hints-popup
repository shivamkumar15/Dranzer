class HintsPopup(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_title("BitBeast Hints")
        self.set_default_size(1080, 720)
        self.set_size_request(1080, 720)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("bitbeast-hints", "bitbeast-hints")

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        # Use EXCLUSIVE to capture Esc and Super+H robustly without click
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, False)

        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual() if screen else None
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_destroy)

        self.cards = []
        self.build_ui()
        self.show_all()

    def build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.set_name("root")
        self.add(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        header.get_style_context().add_class("header")
        root.pack_start(header, False, False, 0)

        icon = Gtk.Label(label="󰌌")
        icon.get_style_context().add_class("title-icon")
        header.pack_start(icon, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.pack_start(title_box, False, False, 0)

        title = Gtk.Label(label="Keyboard Shortcuts")
        title.get_style_context().add_class("title")
        title.set_xalign(0)
        title_box.pack_start(title, False, False, 0)

        sections = parse_keybinds(HYPR_CONFIG)
        if not sections:
            sections = [("General", [
                (["Super", "H"], "Keyboard Hints", "Super + H"),
                (["Super", "Enter"], "Terminal", "Super + Enter"),
                (["Super", "Q"], "Close Window", "Super + Q")
            ])]
            
        total = sum(len(b) for _, b in sections)
        subtitle = Gtk.Label(label=f"{len(sections)} categories · {total} shortcuts")
        subtitle.get_style_context().add_class("subtitle")
        subtitle.set_xalign(0)
        title_box.pack_start(subtitle, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.pack_end(right, False, False, 0)

        pill = Gtk.Label(label="Esc to close")
        pill.get_style_context().add_class("hint-pill")
        right.pack_start(pill, False, False, 0)

        close_btn = Gtk.Button()
        close_btn.set_image(Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON))
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda *_: self.destroy())
        right.pack_start(close_btn, False, False, 0)

        search = Gtk.SearchEntry()
        search.set_placeholder_text("Search keybindings…")
        search.get_style_context().add_class("search")
        search.connect("search-changed", self.on_search_changed)
        root.pack_start(search, False, False, 0)
        self.search_entry = search

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)
        scrolled.get_style_context().add_class("hints-scroll")
        root.pack_start(scrolled, True, True, 0)
        
        scroll_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        scrolled.add(scroll_content)

        self.columns_wrap = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.columns_wrap.set_name("columns")
        self.columns_wrap.set_halign(Gtk.Align.CENTER)
        scroll_content.pack_start(self.columns_wrap, False, False, 0)

        self.no_results = Gtk.Label(label="No matching keybindings")
        self.no_results.get_style_context().add_class("subtitle")
        self.no_results.set_margin_top(40)
        self.no_results.set_visible(False)
        scroll_content.pack_start(self.no_results, False, False, 0)

        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        right_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        left_col.get_style_context().add_class("column")
        right_col.get_style_context().add_class("column")
        self.columns_wrap.pack_start(left_col, True, True, 0)
        self.columns_wrap.pack_start(right_col, True, True, 0)

        # Greedy balance by bind count
        cols = [[0, left_col], [0, right_col]]
        for name, binds in sections:
            idx = 0 if cols[0][0] <= cols[1][0] else 1
            card = self.build_card(name, binds)
            cols[idx][1].pack_start(card, False, False, 0)
            cols[idx][0] += len(binds)

    def build_card(self, name, binds):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.get_style_context().add_class("card")
        card.set_size_request(505, -1)

        hdr = Gtk.Label(label=name.upper())
        hdr.get_style_context().add_class("card-header")
        hdr.set_xalign(0)
        card.pack_start(hdr, False, False, 0)

        rows = []
        for tokens, desc, combo in binds:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.get_style_context().add_class("kb-row")

            chips_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            chips_box.set_size_request(240, -1)
            for tok in tokens:
                chip = Gtk.Label(label=tok)
                chip.get_style_context().add_class("kb-chip")
                chips_box.pack_start(chip, False, False, 0)
            row.pack_start(chips_box, False, False, 0)

            dlab = Gtk.Label(label=desc)
            dlab.get_style_context().add_class("kb-desc")
            dlab.set_xalign(0)
            dlab.set_line_wrap(True)
            dlab.set_line_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            row.pack_start(dlab, True, True, 0)

            card.pack_start(row, False, False, 0)
            rows.append({"row": row, "text": (combo + " " + desc).lower()})

        self.cards.append({"card": card, "rows": rows})
        return card

    def on_search_changed(self, entry):
        q = entry.get_text().strip().lower()
        any_card_visible = False
        
        for c in self.cards:
            any_row_visible = False
            for r in c["rows"]:
                visible = (q == "") or (q in r["text"])
                r["row"].set_visible(visible)
                any_row_visible = any_row_visible or visible
            
            c["card"].set_visible(any_row_visible)
            any_card_visible = any_card_visible or any_row_visible
            
        self.columns_wrap.set_visible(any_card_visible)
        self.no_results.set_visible(not any_card_visible)

    def on_key_press(self, _widget, event):
        name = Gdk.keyval_name(event.keyval)
        
        if name == "Escape":
            if self.search_entry.get_text():
                self.search_entry.set_text("")
            else:
                self.destroy()
            return True
            
        # Toggle on Super+H (since EXCLUSIVE intercepts it)
        if name and name.lower() == "h":
            mod_mask = Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK
            if event.state & mod_mask:
                self.destroy()
                return True
                
        return False

    def on_destroy(self, *_args):
        remove_pid_file()
        Gtk.main_quit()

# ---------- State / Daemon ----------

def toggle_existing_instance():
    os.makedirs(PID_DIR, exist_ok=True)
    if not os.path.exists(PID_FILE):
        return False
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
    except Exception:
        return False
    if old_pid <= 0:
        return False
    try:
        os.kill(old_pid, signal.SIGTERM)
        return True
    except ProcessLookupError:
        return False
    except Exception:
        return False

def write_pid_file():
    os.makedirs(PID_DIR, exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

def remove_pid_file():
    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
    except OSError:
        pass

if toggle_existing_instance():
    remove_pid_file()
    sys.exit(0)

write_pid_file()
signal.signal(signal.SIGTERM, lambda *_: (remove_pid_file(), Gtk.main_quit()))

if __name__ == "__main__":
    HintsPopup()
    Gtk.main()
