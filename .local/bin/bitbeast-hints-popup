#!/usr/bin/env python3
"""
BitBeast Hints Popup — GTK3 + GtkLayerShell centered keyboard shortcut hints.
Triggers/toggles with Super+H.
"""

import os
import re
import signal
import subprocess
import sys
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell

PID_DIR = os.path.expanduser("~/.cache/bitbeast")
PID_FILE = os.path.join(PID_DIR, "hints-popup.pid")

def load_theme():
    theme = {
        "bg": "#150608",
        "primary": "#e8450c",
        "secondary": "#7b120f",
        "accent": "#ffd166",
        "text": "#fff1dd"
    }
    path = os.path.expanduser("~/.config/bitbeast/current.conf")
    if os.path.exists(path):
        with open(path, "r") as f:
            for line in f:
                match = re.match(r"\$(\w+)\s*=\s*(?:rgb\()?([0-9a-fA-F]+)\)?", line.strip())
                if match:
                    name = match.group(1).lower()
                    theme[name] = "#" + match.group(2)
    return theme

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

def format_key(key):
    friendly_names = {
        "return": "Enter",
        "space": "Space",
        "left": "Left Arrow",
        "right": "Right Arrow",
        "up": "Up Arrow",
        "down": "Down Arrow",
        "tab": "Tab",
        "comma": ",",
        "period": ".",
        "delete": "Delete",
        "mouse:272": "Left Mouse",
        "mouse:273": "Right Mouse",
        "mouse_down": "Scroll Down",
        "mouse_up": "Scroll Up",
        "xf86audioraisevolume": "Volume Up",
        "xf86audiolowervolume": "Volume Down",
        "xf86audiomute": "Mute Audio",
        "xf86audiomicmute": "Mute Mic",
        "xf86audioplay": "Play/Pause",
        "xf86audionext": "Next Track",
        "xf86audioprev": "Previous Track",
        "xf86monbrightnessup": "Brightness Up",
        "xf86monbrightnessdown": "Brightness Down",
    }
    normalized = key.strip().lower()
    if normalized in friendly_names:
        return friendly_names[normalized]
    if len(key) == 1:
        return key.upper()
    return key.replace("_", " ").title()

def format_mods(mods):
    friendly_mods = {
        "$mod": "Super",
        "SUPER": "Super",
        "SHIFT": "Shift",
        "CTRL": "Ctrl",
        "CONTROL": "Ctrl",
        "ALT": "Alt",
    }
    return [friendly_mods.get(mod, mod.title()) for mod in mods.split() if mod]

def format_direction(value):
    return {
        "l": "Left",
        "r": "Right",
        "u": "Up",
        "d": "Down",
    }.get(value.lower(), value.upper())

def describe_workspace(value):
    workspace_names = {
        "m+1": "Next Workspace",
        "m-1": "Previous Workspace",
        "e+1": "Next Existing Workspace",
        "e-1": "Previous Existing Workspace",
        "special": "Special Workspace",
    }
    return workspace_names.get(value, f"Workspace {value}")

def describe_exec(command):
    cmd = command.lower()
    if "kitty --class=\"dropdown\"" in cmd:
        return "Open Dropdown Terminal"
    if "kitty" in cmd or "$terminal" in cmd:
        return "Open Terminal"
    if "rofi" in cmd or "$menu" in cmd:
        return "Open App Launcher"
    if "chrome" in cmd or "$browser" in cmd:
        return "Open Browser"
    if "bongocat" in cmd:
        return "Toggle Bongo Cat"
    if "dolphin" in cmd:
        return "Open File Manager"
    if "yazi" in cmd:
        return "Open Terminal File Manager"
    if "bitbeast pick" in cmd:
        return "Choose Wallpaper"
    if "bitbeast style cycle" in cmd:
        return "Cycle Waybar Style"
    if "bitbeast keybindings" in cmd or "hints" in cmd:
        return "Show Keyboard Hints"
    if "bitbeast hancore pick" in cmd:
        return "Choose Waybar Theme"
    if "bitbeast zsh cycle" in cmd:
        return "Cycle Zsh Theme"
    if "bitbeast zsh pick" in cmd:
        return "Choose Zsh Theme"
    if "bitbeast touchpad" in cmd:
        return "Open Touchpad Settings"
    if "bitbeast auto-theme" in cmd:
        return "Apply Theme From Wallpaper"
    if "bitbeast gradient" in cmd:
        return "Generate Gradient Theme"
    if "bitbeast session-init" in cmd:
        return "Reload BitBeast Session"
    if "bitbeast lock" in cmd:
        return "Lock Screen"
    if "bitbeast clipboard" in cmd:
        return "Open Clipboard History"
    if "hyprctl dispatch exit" in cmd:
        return "Exit Hyprland"
    if "hyprctl dispatch workspaceopt allfloat" in cmd:
        return "Toggle Floating Workspace"
    if "grim" in cmd and "slurp" in cmd:
        return "Take Region Screenshot"
    if "grim" in cmd:
        return "Take Full Screenshot"
    if "wpctl set-volume" in cmd and "5%+" in cmd:
        return "Increase Volume"
    if "wpctl set-volume" in cmd and "5%-" in cmd:
        return "Decrease Volume"
    if "wpctl set-mute" in cmd:
        return "Toggle Mute"
    if "playerctl play-pause" in cmd:
        return "Play/Pause Media"
    if "playerctl next" in cmd:
        return "Next Media Track"
    if "playerctl previous" in cmd:
        return "Previous Media Track"
    return re.sub(r'^(~/\.local/bin/|/home/\w+/\.local/bin/)', '', command).strip()

def describe_action(action, extra):
    if action == "exec":
        return describe_exec(extra)
    if action == "killactive":
        return "Close Active Window"
    if action == "fullscreen":
        return "Toggle Fullscreen" if extra != "1" else "Toggle Fake Fullscreen"
    if action == "togglefloating":
        return "Toggle Floating Window"
    if action == "workspace":
        return f"Switch to {describe_workspace(extra)}"
    if action == "movetoworkspace":
        return f"Move Window to {describe_workspace(extra)}"
    if action == "movetoworkspacesilent":
        return f"Move Window to {describe_workspace(extra)}"
    if action == "movefocus":
        return f"Focus Window {format_direction(extra)}"
    if action == "movewindow":
        return f"Move Window {format_direction(extra)}" if extra else "Move Window"
    if action == "resizewindow":
        return "Resize Window With Mouse"
    if action == "resizeactive":
        return "Resize Active Window"
    if action == "layoutmsg" and extra == "togglesplit":
        return "Toggle Split Layout"
    if action == "pseudo":
        return "Toggle Pseudo Tiling"
    if action == "togglespecialworkspace":
        return "Toggle Special Workspace"
    if action == "workspaceopt" and extra == "allfloat":
        return "Toggle Floating Workspace"
    if extra:
        return f"{action.replace('_', ' ').title()} {extra}"
    return action.replace("_", " ").title()

def toggle_existing_instance() -> bool:
    os.makedirs(PID_DIR, exist_ok=True)
    if not os.path.exists(PID_FILE):
        return False
    try:
        with open(PID_FILE, "r", encoding="utf-8") as handle:
            old_pid = int(handle.read().strip())
    except Exception:
        return False
    if old_pid <= 0:
        return False
    try:
        os.kill(old_pid, signal.SIGTERM)
        return True
    except ProcessLookupError:
        return False
    except Exception:
        return False

def write_pid_file():
    os.makedirs(PID_DIR, exist_ok=True)
    with open(PID_FILE, "w", encoding="utf-8") as handle:
        handle.write(str(os.getpid()))

def remove_pid_file():
    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
    except OSError:
        pass

def get_keybinds():
    hypr_config = os.path.expanduser("~/.config/hypr/hyprland.conf")
    if not os.path.exists(hypr_config):
        return []
    
    keybinds = []
    with open(hypr_config, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            
            if line.startswith("bind") and "=" in line:
                parts = line.split("=", 1)[1].strip().split(",")
                if len(parts) >= 3:
                    mods = parts[0].strip()
                    key = parts[1].strip()
                    action = parts[2].strip()
                    extra = ",".join(parts[3:]).strip()
                    
                    mod_list = format_mods(mods)
                    if key:
                        mod_list.append(format_key(key))
                    combo = " + ".join(mod_list)
                    
                    desc = describe_action(action, extra)
                    
                    if desc:
                        keybinds.append((combo, desc))
    
    # Filter duplicates and return
    seen = set()
    unique_keybinds = []
    for combo, desc in keybinds:
        if combo not in seen:
            seen.add(combo)
            unique_keybinds.append((combo, desc))
    return unique_keybinds

theme = load_theme()
r, g, b = hex_to_rgb(theme["bg"])
TEXT = theme["text"]
TEXT_DIM = f"rgba({r}, {g}, {b}, 0.7)" # We can do a lighter text dim:
r_txt, g_txt, b_txt = hex_to_rgb(TEXT)
TEXT_DIM = f"rgba({r_txt}, {g_txt}, {b_txt}, 0.65)"
PRIMARY = theme["primary"]
SECONDARY = theme["secondary"]
ACCENT = theme["accent"]

CSS = f"""
window {{
    background: rgba({r}, {g}, {b}, 0.95);
}}
#popup-frame {{
    background-color: transparent;
    border: 2px solid {PRIMARY};
    border-radius: 30px;
    padding: 20px;
}}
.title-label {{
    font-family: "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: {PRIMARY};
}}
.inner-panel {{
    background-color: transparent;
    border: 0px;
    border-radius: 0px;
    padding: 8px 34px 14px 34px;
}}
.keybind-row {{
    background: transparent;
    border-radius: 0px;
    border: 0px;
    padding: 4px 0px;
}}
.keybind-num {{
    font-family: "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 17px;
    font-weight: bold;
    color: {TEXT_DIM};
}}
.keybind-combo {{
    font-family: "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 17px;
    font-weight: bold;
    color: {ACCENT};
}}
.keybind-action {{
    font-family: "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 17px;
    color: {TEXT};
}}
"""

class HintsPopup(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_wmclass("bitbeast-hints", "bitbeast-hints")
        self.set_title("Hints")
        self.set_default_size(1080, 675)
        self.set_size_request(1080, 675)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("destroy", self.on_destroy)
        
        self.build_ui()
        self.show_all()

    def on_destroy(self, *_args):
        remove_pid_file()
        Gtk.main_quit()

    def on_focus_out(self, *_args):
        self.destroy()

    def on_key_press(self, _widget, event):
        if Gdk.keyval_name(event.keyval) in ("Escape", "q"):
            self.destroy()

    def build_ui(self):
        main_frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_frame.set_name("popup-frame")
        main_frame.set_hexpand(True)
        main_frame.set_vexpand(True)
        self.add(main_frame)

        center_wrap = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        center_wrap.set_hexpand(True)
        center_wrap.set_vexpand(True)
        main_frame.pack_start(center_wrap, True, True, 0)

        left_spacer = Gtk.Box()
        left_spacer.set_hexpand(True)
        center_wrap.pack_start(left_spacer, True, True, 0)

        inner_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        inner_panel.get_style_context().add_class("inner-panel")
        inner_panel.set_size_request(980, 635)
        inner_panel.set_hexpand(False)
        inner_panel.set_vexpand(False)
        inner_panel.set_valign(Gtk.Align.CENTER)
        center_wrap.pack_start(inner_panel, False, False, 0)

        right_spacer = Gtk.Box()
        right_spacer.set_hexpand(True)
        center_wrap.pack_start(right_spacer, True, True, 0)

        title_label = Gtk.Label(label="Hints")
        title_label.get_style_context().add_class("title-label")
        title_label.set_halign(Gtk.Align.CENTER)
        title_label.set_margin_bottom(8)
        inner_panel.pack_start(title_label, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)
        inner_panel.pack_start(scrolled, True, True, 0)

        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        list_box.set_hexpand(True)
        list_box.set_margin_top(2)
        scrolled.add(list_box)
        
        keybinds = get_keybinds()
        
        # If no keybinds could be parsed, provide a fallback list
        if not keybinds:
            keybinds = [
                ("Super + Enter", "Terminal"),
                ("Super + Shift + Enter", "Dropdown Terminal"),
                ("Super + R", "Application Menu"),
                ("Super + B", "Browser"),
                ("Super + E", "File Manager"),
                ("Super + H", "Keyboard Hints"),
                ("Super + Q", "Close Window"),
                ("Super + Space", "Toggle Floating Window"),
                ("Super + L", "Lock Screen"),
                ("Super + V", "Clipboard History"),
                ("Super + S", "Screenshot (Region)"),
            ]
            
        for idx, (combo, desc) in enumerate(keybinds, start=1):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            row.get_style_context().add_class("keybind-row")
            
            num_label = Gtk.Label(label=f"{idx:02d}. ")
            num_label.get_style_context().add_class("keybind-num")
            num_label.set_xalign(0)
            num_label.set_yalign(0.5)
            num_label.set_size_request(50, -1)
            row.pack_start(num_label, False, False, 0)
            
            combo_label = Gtk.Label(label=combo)
            combo_label.get_style_context().add_class("keybind-combo")
            combo_label.set_xalign(0)
            combo_label.set_yalign(0.5)
            combo_label.set_size_request(340, -1)
            row.pack_start(combo_label, False, False, 0)
            
            separator = Gtk.Label(label=" = ")
            separator.get_style_context().add_class("keybind-combo")
            separator.set_xalign(0)
            separator.set_yalign(0.5)
            separator.set_size_request(28, -1)
            row.pack_start(separator, False, False, 0)
            
            desc_label = Gtk.Label(label=desc)
            desc_label.get_style_context().add_class("keybind-action")
            desc_label.set_xalign(0)
            desc_label.set_yalign(0.5)
            desc_label.set_line_wrap(True)
            desc_label.set_max_width_chars(42)
            row.pack_start(desc_label, True, True, 0)
            
            list_box.pack_start(row, False, False, 0)

if toggle_existing_instance():
    remove_pid_file()
    sys.exit(0)

write_pid_file()
signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())

if __name__ == "__main__":
    HintsPopup()
    Gtk.main()
