#!/usr/bin/env python3
"""
BitBeast Hints Popup — GTK3 + GtkLayerShell centered keyboard shortcut hints.
Grouped, searchable, theme-aware. Toggles with Super+H (bitbeast keybindings).
"""

import os
import re
import signal
import sys
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell

PID_DIR = os.path.expanduser("~/.cache/bitbeast")
PID_FILE = os.path.join(PID_DIR, "hints-popup.pid")
HYPR_CONFIG = os.path.expanduser("~/.config/hypr/hyprland.conf")

# ---------- Theme ----------
def load_theme():
    theme = {
        "bg": "#150608",
        "primary": "#ff2d55",
        "secondary": "#2c0d0f",
        "accent": "#ffd166",
        "text": "#fff1dd"
    }
    path = os.path.expanduser("~/.config/bitbeast/current.conf")
    if os.path.exists(path):
        with open(path, "r") as f:
            for line in f:
                match = re.match(r"\$(\w+)\s*=\s*(?:rgb\()?([0-9a-fA-F]+)\)?", line.strip())
                if match:
                    theme[match.group(1).lower()] = "#" + match.group(2)
    return theme

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

def rgba(hex_str, alpha):
    r, g, b = hex_to_rgb(hex_str)
    return f"rgba({r}, {g}, {b}, {alpha})"

# ---------- Parsing & Formatting ----------

SECTION_RENAMES = {
    "Hold SUPER and drag an app with mouse to move/resize it": "Mouse",
    "Scroll through existing workspaces": "Workspace Scroll",
    "Send active app to a workspace and stay on the current workspace": "Send to Workspace (Stay)",
    "Send active app to a workspace and follow it": "Send to Workspace (Follow)",
    "Window focus (vim keys)": "Focus (Vim)",
    "Window focus (arrow keys)": "Focus (Arrows)",
    "Move windows (vim keys)": "Move (Vim)",
    "Move windows (arrow keys)": "Move (Arrows)",
    "Execution and Launchers": "Launchers",
    "HANCORE Waybar Themes": "Waybar Themes",
    "Touchpad Sensitivity Selector": "Touchpad",
    "Auto Theme from Wallpaper": "Auto Theme",
    "Desktop/Workspace": "Session",
    "Brightness (hardware keys)": "Brightness",
    "Brightness (hardware keys) — BitBeast OSD slider": "Brightness",
    "Volume — BitBeast OSD slider": "Volume",
    "Volume": "Volume",
    "Media keys": "Media Keys",
    "Gestures": "Touchpad Gestures",
}

# Extra touchpad gestures handled by bitbeast-volume-gesture (not Hyprland bind lines)
TOUCHPAD_GESTURE_HINTS = [
    (["3 Fingers", "← →"], "Switch Workspace", "3-Finger Horizontal Swipe"),
    (["3 Fingers", "↑"], "Workspace Overview", "3-Finger Swipe Up"),
    (["4 Fingers", "↑"], "Increase Volume", "4-Finger Swipe Up"),
    (["4 Fingers", "↓"], "Decrease Volume", "4-Finger Swipe Down"),
    (["4 Fingers", "Tap"], "Play / Pause Media", "4-Finger Tap"),
]

def clean_section(name):
    name = name.strip()
    if name in SECTION_RENAMES:
        return SECTION_RENAMES[name]
    if len(name) < 20 and name.islower():
        return name.title()
    return name

def format_key(key):
    friendly_names = {
        "return": "Enter", "space": "Space",
        "left": "Left", "right": "Right", "up": "Up", "down": "Down",
        "tab": "Tab", "comma": ",", "period": ".", "delete": "Delete",
        "mouse:272": "Left Mouse", "mouse:273": "Right Mouse",
        "mouse_down": "Scroll Down", "mouse_up": "Scroll Up",
        "xf86audioraisevolume": "Vol Up", "xf86audiolowervolume": "Vol Down",
        "xf86audiomute": "Mute Audio", "xf86audiomicmute": "Mute Mic",
        "xf86audioplay": "Play/Pause", "xf86audionext": "Next Track",
        "xf86audioprev": "Prev Track", "xf86monbrightnessup": "Bright Up",
        "xf86monbrightnessdown": "Bright Down",
    }
    normalized = key.strip().lower()
    if normalized in friendly_names:
        return friendly_names[normalized]
    if len(key) == 1:
        return key.upper()
    return key.replace("_", " ").title()

def format_mods(mods):
    friendly_mods = {
        "$mod": "Super", "SUPER": "Super", "SHIFT": "Shift",
        "CTRL": "Ctrl", "CONTROL": "Ctrl", "ALT": "Alt",
    }
    return [friendly_mods.get(mod, mod.title()) for mod in mods.split() if mod]

def describe_workspace(value):
    workspace_names = {
        "m+1": "Next Workspace", "m-1": "Prev Workspace",
        "e+1": "Next Existing", "e-1": "Prev Existing",
        "special": "Special Workspace",
    }
    return workspace_names.get(value, f"Workspace {value}")

def describe_exec(command):
    cmd = command.lower()
    if "kitty --class=\"dropdown\"" in cmd: return "Dropdown Terminal"
    if "kitty" in cmd or "$terminal" in cmd: return "Terminal"
    if "rofi" in cmd or "$menu" in cmd: return "App Launcher"
    if "chrome" in cmd or "$browser" in cmd: return "Browser"
    if "bongocat" in cmd: return "Toggle Bongo Cat"
    if "dolphin" in cmd: return "File Manager"
    if "yazi" in cmd: return "Terminal File Manager"
    if "bitbeast pick" in cmd: return "Choose Wallpaper"
    if "bitbeast style cycle" in cmd: return "Cycle Waybar Style"
    if "bitbeast keybindings" in cmd or "hints" in cmd: return "Keyboard Hints"
    if "bitbeast hancore pick" in cmd: return "Choose Waybar Theme"
    if "bitbeast zsh cycle" in cmd: return "Cycle Zsh Theme"
    if "bitbeast zsh pick" in cmd: return "Choose Zsh Theme"
    if "bitbeast touchpad" in cmd: return "Touchpad Settings"
    if "bitbeast auto-theme" in cmd: return "Apply Theme From Wallpaper"
    if "bitbeast gradient" in cmd: return "Generate Gradient Theme"
    if "bitbeast session-init" in cmd: return "Reload Session"
    if "bitbeast lock" in cmd: return "Lock Screen"
    if "bitbeast clipboard" in cmd: return "Clipboard History"
    if "toggle-transparency" in cmd: return "Toggle Transparency"
    if "hyprctl dispatch exit" in cmd: return "Exit Hyprland"
    if "workspaceopt allfloat" in cmd: return "Toggle Floating Workspace"
    if "grim" in cmd and "slurp" in cmd: return "Region Screenshot"
    if "grim" in cmd: return "Full Screenshot"
    if "bitbeast-osd" in cmd and "volume raise" in cmd: return "Increase Volume"
    if "bitbeast-osd" in cmd and "volume lower" in cmd: return "Decrease Volume"
    if "bitbeast-osd" in cmd and "volume mute" in cmd: return "Toggle Mute"
    if "bitbeast-osd" in cmd and "brightness raise" in cmd: return "Increase Brightness"
    if "bitbeast-osd" in cmd and "brightness lower" in cmd: return "Decrease Brightness"
    if "wpctl set-volume" in cmd and ("5%+" in cmd or "raise" in cmd): return "Increase Volume"
    if "wpctl set-volume" in cmd and ("5%-" in cmd or "lower" in cmd): return "Decrease Volume"
    if "wpctl set-mute" in cmd and "source" in cmd: return "Toggle Mic Mute"
    if "wpctl set-mute" in cmd: return "Toggle Mute"
    if "playerctl play-pause" in cmd: return "Play/Pause Media"
    if "playerctl next" in cmd: return "Next Media Track"
    if "playerctl previous" in cmd: return "Previous Media Track"
    if "bitbeast-workspaces" in cmd: return "Workspace Overview"
    if "bitbeast-volume-gesture" in cmd: return "Touchpad Volume Gestures"
    return re.sub(r'^(~/\.local/bin/|/home/\w+/\.local/bin/)', '', command).strip()

def describe_action(action, extra, is_mouse=False):
    if is_mouse:
        if action == "movewindow": return "Drag to Move Window"
        if action == "resizewindow": return "Drag to Resize Window"
        
    if action == "exec": return describe_exec(extra)
    if action == "killactive": return "Close Window"
    if action == "fullscreen": return "Toggle Fullscreen" if extra != "1" else "Fake Fullscreen"
    if action == "togglefloating": return "Toggle Floating"
    if action == "workspace": return f"Switch to {describe_workspace(extra)}"
    if action in ("movetoworkspace", "movetoworkspacesilent"): return f"Move to {describe_workspace(extra)}"
    
    direction = {"l": "Left", "r": "Right", "u": "Up", "d": "Down"}.get(extra.lower(), extra.upper())
    if action == "movefocus": return f"Focus {direction}"
    if action == "movewindow": return f"Move {direction}" if extra else "Move Window"
    
    if action == "resizewindow": return "Resize Window With Mouse"
    if action == "resizeactive":
        dims = extra.replace(",", " ").split()
        if len(dims) >= 2:
            try: dx, dy = int(dims[0]), int(dims[1])
            except ValueError: return "Resize Window"
            if dx < 0: return "Shrink Horizontally"
            if dx > 0: return "Grow Horizontally"
            if dy < 0: return "Shrink Vertically"
            if dy > 0: return "Grow Vertically"
        return "Resize Window"
        
    if action == "layoutmsg" and extra == "togglesplit": return "Toggle Split Layout"
    if action == "pseudo": return "Toggle Pseudo Tiling"
    if action == "togglespecialworkspace": return "Toggle Special Workspace"
    if action == "workspaceopt" and extra == "allfloat": return "Toggle Floating Workspace"
    
    return f"{action.replace('_', ' ').title()} {extra}".strip()

def parse_keybinds(path):
    if not os.path.exists(path):
        return []
        
    sections = []
    current_section = None
    current_binds = []
    seen = set()

    def flush():
        nonlocal current_section, current_binds
        if current_section and current_binds:
            # Skip empty / commentary-only gesture sections; we inject a full set later
            if current_section not in ("Gestures", "Touchpad Gestures"):
                sections.append((current_section, list(current_binds)))
            current_binds.clear()

    with open(path, "r") as f:
        for raw in f:
            line = raw.strip()
            if not line:
                continue
            
            if line.startswith("#"):
                header = line.lstrip("#").strip()
                if not header:
                    continue
                # Skip note lines under section headers (not real categories)
                lower = header.lower()
                if lower.startswith(("3-finger", "4-finger", "(", "windows-style")):
                    continue
                flush()
                current_section = clean_section(header)
                continue
                
            match = re.match(r"^bind[a-z]*\s*=\s*", line)
            if match:
                is_mouse = line.startswith("bindm")
                rest = line[match.end():]
                parts = [p.strip() for p in rest.split(",")]
                if len(parts) < 3:
                    continue
                
                mods, key, action = parts[0], parts[1], parts[2]
                extra = ",".join(parts[3:])
                
                tokens = format_mods(mods)
                if key:
                    tokens.append(format_key(key))
                combo = " + ".join(tokens)
                
                if combo in seen:
                    continue
                seen.add(combo)
                
                desc = describe_action(action, extra, is_mouse)
                if desc:
                    if current_section is None:
                        current_section = "General"
                    # Don't put keybinds into the gesture bucket
                    if current_section in ("Gestures", "Touchpad Gestures"):
                        current_section = "General"
                    current_binds.append((tokens, desc, combo))
                continue

            # Ignore raw gesture= lines here; full set is injected below
            if line.startswith("gesture"):
                continue

    flush()

    # Canonical touchpad gestures (Hyprland 3-finger + bitbeast-volume-gesture 4-finger)
    sections.insert(0, ("Touchpad Gestures", list(TOUCHPAD_GESTURE_HINTS)))
    return sections

# ---------- UI & State ----------

THEME = load_theme()
BG = THEME["bg"]
PRIMARY = THEME["primary"]
SECONDARY = THEME["secondary"]
ACCENT = THEME["accent"]
TEXT = THEME["text"]

CSS = f"""
* {{
    font-family: "JetBrainsMono Nerd Font", "DejaVu Sans", sans-serif;
}}
window {{
    background: transparent;
}}
#root {{
    background: {rgba(BG, 0.93)};
    border: 1px solid {rgba(PRIMARY, 0.45)};
    border-radius: 24px;
    padding: 20px 22px 16px 22px;
}}
.header {{ padding: 2px 4px 14px 4px; }}
.title-icon {{
    font-size: 26px;
    color: {PRIMARY};
}}
