#!/bin/bash

# BitBeast workspace/window overview.
# Requires a rofi build with Wayland window thumbnails for previews.

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
ROFI_THEME="$CONFIG_HOME/rofi/overview.rasi"

exec rofi \
    -show window \
    -window-thumbnail \
    -theme "$ROFI_THEME" \
    -kb-cancel "Escape,Super_L" \
    -selected-row 0
