class ControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.player = None
        self.previous_cpu = None
        self._updating_sliders = False

        self.set_default_size(1280, 600)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 90)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, 22)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_destroy)

        self.build_ui()
        self.refresh()
        GLib.timeout_add(1500, self.refresh)
        self.show_all()

    def on_destroy(self, *_args):
        remove_pid_file()
        Gtk.main_quit()

    def on_key_press(self, _widget, event):
        if Gdk.keyval_name(event.keyval) == "Escape":
            self.destroy()

    def launch(self, command):
        run(command)
        self.destroy()

    def build_label(self, text, css_class, xalign=0.0):
        label = Gtk.Label(label=text)
        label.set_xalign(xalign)
        label.get_style_context().add_class(css_class)
        return label

    def build_icon_label(self, glyph, css_class="glyph"):
        label = Gtk.Label(label=glyph)
        label.get_style_context().add_class(css_class)
        return label

    # ------------------------------------------------------------------
    # media card
    # ------------------------------------------------------------------

    def build_media_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class("card")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.art_image = Gtk.Image()
        self.art_image.set_size_request(56, 56)
        self.art_image.set_from_icon_name("audio-x-generic", Gtk.IconSize.DIALOG)
        self.art_image.set_valign(Gtk.Align.CENTER)
        top.pack_start(self.art_image, False, False, 0)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        info.set_valign(Gtk.Align.CENTER)
        self.media_title = self.build_label("No active media", "media-title", 0.0)
        self.media_artist = self.build_label("Start a player to see controls", "media-sub", 0.0)
        self.media_title.set_ellipsize(Pango.EllipsizeMode.END)
        info.pack_start(self.media_title, False, False, 0)
        info.pack_start(self.media_artist, False, False, 0)
        top.pack_start(info, True, True, 0)

        mixer_btn = Gtk.Button(label="󰎈")
        mixer_btn.get_style_context().add_class("icon-btn")
        mixer_btn.set_tooltip_text("Open mixer")
        mixer_btn.set_valign(Gtk.Align.CENTER)
        mixer_btn.connect("clicked", lambda *_: self.on_audio_settings())
        top.pack_end(mixer_btn, False, False, 0)
        card.pack_start(top, False, False, 0)

        self.progress = Gtk.ProgressBar()
        card.pack_start(self.progress, False, False, 0)

        time_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.media_pos = self.build_label("0:00", "media-sub", 0.0)
        self.media_dur = self.build_label("0:00", "media-sub", 1.0)
        time_row.pack_start(self.media_pos, False, False, 0)
        time_row.pack_end(self.media_dur, False, False, 0)
        card.pack_start(time_row, False, False, 0)

        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        controls.set_halign(Gtk.Align.CENTER)

        prev_btn = Gtk.Button(label="󰒮")
        prev_btn.get_style_context().add_class("transport-btn")
        prev_btn.connect("clicked", lambda *_: self.media_action("previous"))

        self.play_btn = Gtk.Button(label="󰐊")
        self.play_btn.set_name("play-btn")
        self.play_btn.get_style_context().add_class("transport-btn")
        self.play_btn.connect("clicked", lambda *_: self.media_action("play-pause"))

        next_btn = Gtk.Button(label="󰒭")
        next_btn.get_style_context().add_class("transport-btn")
        next_btn.connect("clicked", lambda *_: self.media_action("next"))

        controls.pack_start(prev_btn, False, False, 0)
        controls.pack_start(self.play_btn, False, False, 0)
        controls.pack_start(next_btn, False, False, 0)
        card.pack_start(controls, False, False, 0)

        return card

    # ------------------------------------------------------------------
    # quick toggles
    # ------------------------------------------------------------------

    def build_tile(self, glyph, title, callback):
        button = Gtk.Button()
        button.get_style_context().add_class("tile-btn")
        button.set_tooltip_text(title)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        content.set_halign(Gtk.Align.CENTER)
        content.set_valign(Gtk.Align.CENTER)

        icon = self.build_icon_label(glyph, "tile-icon")
        icon.get_style_context().add_class("glyph")
        label = self.build_label(title, "tile-label")
        label.get_style_context().add_class("section-subtitle")

        content.pack_start(icon, False, False, 0)
        content.pack_start(label, False, False, 0)
        button.add(content)
        button.connect("clicked", lambda *_: callback())
        return button

    def build_quick_grid(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class("card")

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.pack_start(self.build_label("Quick toggles", "section-title", 0.0), False, False, 0)
        self.dnd_hint = self.build_label(notification_summary(), "section-subtitle", 1.0)
        header.pack_end(self.dnd_hint, False, False, 0)
        card.pack_start(header, False, False, 0)

        grid = Gtk.Grid()
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)
        grid.set_column_spacing(10)

        self.wifi_tile = self.build_tile("󰤨", "Wi-Fi", self.on_wifi_toggle)
        self.bluetooth_tile = self.build_tile("󰂯", "Bluetooth", self.on_bluetooth_toggle)
        self.airplane_tile = self.build_tile("󰀝", "Airplane", self.on_airplane_toggle)
        self.dnd_tile = self.build_tile("󰂛", "Do Not Disturb", self.on_dnd_toggle)
        screenshot_tile = self.build_tile("󰄀", "Screenshot", self.on_screenshot)
        settings_tile = self.build_tile("󰒓", "Network", self.on_network_settings)

        for col, tile in enumerate((self.wifi_tile, self.bluetooth_tile, self.airplane_tile)):
            grid.attach(tile, col, 0, 1, 1)
        for col, tile in enumerate((self.dnd_tile, screenshot_tile, settings_tile)):
            grid.attach(tile, col, 1, 1, 1)

        card.pack_start(grid, False, False, 0)
        return card

    # ------------------------------------------------------------------
    # sliders
    # ------------------------------------------------------------------

    def build_slider_row(self, glyph, scale, value_label, mute_callback=None):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        icon_holder = Gtk.Box()
        icon_holder.set_size_request(40, 40)
        icon_holder.set_valign(Gtk.Align.CENTER)
        icon = self.build_icon_label(glyph, "accent-glyph")
        icon_holder.pack_start(icon, True, True, 0)
        row.pack_start(icon_holder, False, False, 0)

        scale.set_hexpand(True)
        scale.set_valign(Gtk.Align.CENTER)
        row.pack_start(scale, True, True, 0)

        value_label.set_xalign(1.0)
        value_label.set_valign(Gtk.Align.CENTER)
        row.pack_start(value_label, False, False, 0)

        if mute_callback is not None:
            self.mute_btn = Gtk.Button(label="󰕾")
            self.mute_btn.get_style_context().add_class("icon-btn")
            self.mute_btn.set_valign(Gtk.Align.CENTER)
            self.mute_btn.connect("clicked", lambda *_: mute_callback())
            row.pack_start(self.mute_btn, False, False, 0)

        return row

    def build_sliders_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("card")

        self.volume_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume_scale.set_draw_value(False)
        self.volume_scale.connect("value-changed", self.on_volume_changed)
        self.volume_value = self.build_label("0%", "slider-value", 1.0)
        card.pack_start(
            self.build_slider_row("󰕾", self.volume_scale, self.volume_value, self.on_volume_mute),
            False, False, 0,
        )

        separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        card.pack_start(separator, False, False, 0)

        self.brightness_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.brightness_scale.set_draw_value(False)
        self.brightness_scale.connect("value-changed", self.on_brightness_changed)
        self.brightness_value = self.build_label("0%", "slider-value", 1.0)
        card.pack_start(
            self.build_slider_row("󰃠", self.brightness_scale, self.brightness_value),
            False, False, 0,
        )

        self.sink_caption = self.build_label("Default Output", "section-subtitle", 0.0)
        card.pack_start(self.sink_caption, False, False, 0)

        return card

    # ------------------------------------------------------------------
    # right column
    # ------------------------------------------------------------------

    def build_notifications_card(self):
        button = Gtk.Button()
        button.get_style_context().add_class("row-btn")
        button.connect("clicked", lambda *_: self.on_notification_panel())

        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        outer.set_valign(Gtk.Align.CENTER)

        icon_holder = Gtk.Box()
        icon_holder.set_size_request(44, 44)
        icon_holder.pack_start(self.build_icon_label("󰂚", "accent-glyph"), True, True, 0)
        outer.pack_start(icon_holder, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text.pack_start(self.build_label("Notifications", "section-title", 0.0), False, False, 0)
        self.notification_subtitle = self.build_label("No new notifications", "section-subtitle", 0.0)
        text.pack_start(self.notification_subtitle, False, False, 0)
        outer.pack_start(text, True, True, 0)
        outer.pack_end(self.build_icon_label("󰅂", "dim-glyph"), False, False, 0)

        button.add(outer)
        return button

    def build_clock_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("card")

        self.time_label = self.build_label("00:00", "time", 0.0)
        self.date_label = self.build_label("Monday, Jan 01", "date", 0.0)
        card.pack_start(self.time_label, False, False, 0)
        card.pack_start(self.date_label, False, False, 0)

        separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        card.pack_start(separator, False, False, 8)

        stats_flow = Gtk.FlowBox()
        stats_flow.set_max_children_per_line(4)
        stats_flow.set_min_children_per_line(4)
        stats_flow.set_column_spacing(8)
        stats_flow.set_row_spacing(8)
        stats_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        stats_flow.set_homogeneous(False)

        self.stat_labels = {}
        for key in ("CPU", "RAM", "Disk", "BAT"):
            chip = Gtk.Box()
            chip.get_style_context().add_class("chip")
            label = self.build_label(f"{key} 0%", "chip-label", 0.5)
            chip.pack_start(label, True, True, 0)
            self.stat_labels[key] = label
            stats_flow.add(chip)

        card.pack_start(stats_flow, False, False, 0)
        return card

    def build_session_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class("card")
        card.pack_start(self.build_label("Session actions", "section-title", 0.0), False, False, 0)

        grid = Gtk.Grid()
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)
        grid.set_column_spacing(10)
        grid.attach(self.build_session_action("󰤄", "Suspend", lambda *_: self.run_action("suspend")), 0, 0, 1, 1)
        grid.attach(self.build_session_action("󰍃", "Logout", lambda *_: self.run_action("logout")), 1, 0, 1, 1)
        grid.attach(self.build_session_action("󰜉", "Restart", lambda *_: self.run_action("reboot")), 0, 1, 1, 1)
        grid.attach(self.build_session_action("⏻", "Shutdown", lambda *_: self.run_action("shutdown"), danger=True), 1, 1, 1, 1)
        card.pack_start(grid, False, False, 0)
        return card

    def build_session_action(self, glyph, text, callback, danger=False):
        button = Gtk.Button()
        button.get_style_context().add_class("session-btn")
        if danger:
            button.set_name("danger-btn")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.build_icon_label(glyph, "accent-glyph" if danger else "glyph"), False, False, 0)
        box.pack_start(self.build_label(text, "section-title", 0.0), False, False, 0)
        button.add(box)
        button.connect("clicked", callback)
        return button

    # ------------------------------------------------------------------
    # layout
    # ------------------------------------------------------------------

    def build_ui(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        panel.set_name("panel")

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        left.set_size_request(500, -1)
        left.pack_start(self.build_media_card(), False, False, 0)
        left.pack_start(self.build_quick_grid(), False, False, 0)
        left.pack_start(self.build_sliders_card(), True, True, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        right.set_size_request(380, -1)
        right.pack_start(self.build_clock_card(), False, False, 0)
        right.pack_start(self.build_notifications_card(), False, False, 0)
        right.pack_start(self.build_session_card(), True, True, 0)

        panel.pack_start(left, True, True, 0)
        panel.pack_start(right, False, False, 0)
        self.add(panel)

    # ------------------------------------------------------------------
    # state helpers
    # ------------------------------------------------------------------

    def set_tile_state(self, button, active):
        context = button.get_style_context()
        context.remove_class("tile-active")
        if active:
            context.add_class("tile-active")

    # ------------------------------------------------------------------
    # actions
    # ------------------------------------------------------------------

    def on_wifi_toggle(self):
        toggle_wifi()
        GLib.timeout_add(300, self.refresh)

    def on_bluetooth_toggle(self):
        toggle_bluetooth()
        GLib.timeout_add(300, self.refresh)

    def on_airplane_toggle(self):
        toggle_airplane()
        GLib.timeout_add(400, self.refresh)

    def on_dnd_toggle(self):
        toggle_dnd()
        GLib.timeout_add(200, self.refresh)

    def on_screenshot(self):
        mkdir = ["sh", "-c", "mkdir -p ~/Pictures/Screenshots"]
        subprocess.run(mkdir, stderr=subprocess.DEVNULL)
        run(["sh", "-c",
             'grim -g "$(slurp)" - | tee ~/Pictures/Screenshots/$(date +\'%Y-%m-%d-%H%M%S\').png | wl-copy'])
        self.destroy()

    def on_notification_panel(self):
        run(["swaync-client", "-t"])
        self.destroy()

    def on_volume_mute(self):
        toggle_volume_mute()
        self.refresh()

    def on_lock(self):
        self.launch(["hyprlock"])

    def on_network_settings(self):
        self.launch(["kitty", "-e", "nmtui"])

    def on_audio_settings(self):
        self.launch(["pavucontrol"])

    def on_volume_changed(self, scale):
        if self._updating_sliders:
            return
        set_volume_percent(scale.get_value())

    def on_brightness_changed(self, scale):
        if self._updating_sliders:
            return
        set_brightness_percent(scale.get_value())

    def media_action(self, action):
        player = get_player()
        if player:
            run(["playerctl", "-p", player, action])
            GLib.timeout_add(150, self.refresh)

    def run_action(self, action):
        run([os.path.expanduser("~/.local/bin/bitbeast-session"), action])
        self.destroy()

    # ------------------------------------------------------------------
    # refresh
    # ------------------------------------------------------------------

    def refresh_media(self):
        self.player = get_player()
        if not self.player:
            self.media_title.set_text("No active media")
            self.media_artist.set_text("Start a player to see controls")
            self.progress.set_fraction(0.0)
            self.media_pos.set_text("0:00")
            self.media_dur.set_text("0:00")
            self.play_btn.set_label("󰐊")
            self.art_image.set_from_icon_name("audio-x-generic", Gtk.IconSize.DIALOG)
            return

        status = cmd(["playerctl", "-p", self.player, "status"])
        title = cmd(["playerctl", "-p", self.player, "metadata", "title"])[:48] or "Unknown Track"
        artist = cmd(["playerctl", "-p", self.player, "metadata", "artist"])[:38] or "Unknown Artist"
        pos = cmd(["playerctl", "-p", self.player, "position"])
        dur_us = cmd(["playerctl", "-p", self.player, "metadata", "mpris:length"])

        self.media_title.set_text(title)
        self.media_artist.set_text(artist)
        self.play_btn.set_label("󰏤" if status == "Playing" else "󰐊")
        self.art_image.set_from_icon_name("audio-x-generic", Gtk.IconSize.DIALOG)

        try:
            pos_s = float(pos)
            dur_s = int(dur_us) / 1_000_000 if dur_us else 0
            self.progress.set_fraction(min(pos_s / dur_s, 1.0) if dur_s > 0 else 0.0)
            self.media_pos.set_text(fmt_time(pos_s))
            self.media_dur.set_text(fmt_time(dur_s))
        except Exception:
            self.progress.set_fraction(0.0)
            self.media_pos.set_text("0:00")
            self.media_dur.set_text("0:00")

    def refresh_toggles(self):
        self.set_tile_state(self.wifi_tile, wifi_enabled())
        self.set_tile_state(self.bluetooth_tile, bluetooth_enabled())
        self.set_tile_state(self.airplane_tile, airplane_enabled())
        self.set_tile_state(self.dnd_tile, dnd_enabled())
        self.dnd_hint.set_text(notification_summary())

    def refresh_sliders(self):
        self._updating_sliders = True
        volume = get_volume_percent()
        brightness = get_brightness_percent()
        muted = get_volume_muted()
        self.volume_scale.set_value(max(0, min(volume, 100)))
        self.brightness_scale.set_value(max(0, min(brightness, 100)))
        self.volume_value.set_text("Muted" if muted else f"{volume}%")
        if self.mute_btn:
            self.mute_btn.set_label("󰝟" if muted else "󰕾")
        self.brightness_value.set_text(f"{brightness}%")
        self.sink_caption.set_text(f"Output: {sink_name()}")
        self._updating_sliders = False

    def refresh_status(self):
        self.notification_subtitle.set_text(notification_summary())

        now = datetime.now()
        self.time_label.set_text(now.strftime("%H:%M"))
        self.date_label.set_text(now.strftime("%A, %b %d"))

        cpu, self.previous_cpu = cpu_usage_percent(self.previous_cpu)
        self.stat_labels["CPU"].set_text(f"CPU {int(cpu)}%")
        self.stat_labels["RAM"].set_text(f"RAM {ram_usage_percent()}%")
        self.stat_labels["Disk"].set_text(f"Disk {disk_usage_percent()}%")

        battery = battery_info()
        if battery:
            percent, charging = battery
            prefix = "⚡" if charging else "BAT"
            self.stat_labels["BAT"].set_text(f"{prefix} {percent}%")
        else:
            self.stat_labels["BAT"].set_text("BAT —")

    def refresh(self):
        self.refresh_media()
        self.refresh_toggles()
        self.refresh_sliders()
        self.refresh_status()
        return True


def sink_name():
    sink = cmd(["pactl", "get-default-sink"])
    if sink:
        return sink.rsplit(".", 1)[-1].replace("_", " ").title()
    info = cmd(["pactl", "info"])
    match = re.search(r"Default Sink:\s*(.+)", info)
    if not match:
        return "Default Output"
    return match.group(1).rsplit(".", 1)[-1].replace("_", " ").title()


if toggle_existing_instance():
    remove_pid_file()
    sys.exit(0)

write_pid_file()
signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())

if __name__ == "__main__":
    ControlCenter()
    Gtk.main()
