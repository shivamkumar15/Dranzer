#!/bin/sh
# BitBeast Battery Watcher — notify at 100%, 20%, and 10%

set -eu

FULL_THRESHOLD=100
LOW_THRESHOLD=20
CRITICAL_THRESHOLD=10
INTERVAL=${BITBEAST_BATTERY_INTERVAL:-60}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bitbeast"
mkdir -p "$STATE_DIR"

FULL_FLAG="$STATE_DIR/battery-full.flag"
LOW_FLAG="$STATE_DIR/battery-low.flag"
CRITICAL_FLAG="$STATE_DIR/battery-critical.flag"

find_battery() {
    for bat in /sys/class/power_supply/BAT*; do
        [ -d "$bat" ] || continue
        printf '%s\n' "$bat"
        return 0
    done
    return 1
}

send_notification() {
    urgency=$1
    summary=$2
    body=$3

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -a "BitBeast" "$summary" "$body"
    fi
}

reset_low_flags() {
    rm -f "$LOW_FLAG" "$CRITICAL_FLAG"
}

reset_full_flag() {
    rm -f "$FULL_FLAG"
}

notify_full() {
    [ -f "$FULL_FLAG" ] && return 0
    send_notification "normal" "Battery Full" "Battery is at $1% — you can unplug the charger."
    : > "$FULL_FLAG"
}

notify_low() {
    [ -f "$LOW_FLAG" ] && return 0
    send_notification "normal" "Low Battery" "Battery is at $1%. Please plug in the charger."
    : > "$LOW_FLAG"
}

notify_critical() {
    [ -f "$CRITICAL_FLAG" ] && return 0
    send_notification "critical" "Ultimate Low Battery" "Battery is at $1%! Plug in now to avoid shutdown."
    : > "$CRITICAL_FLAG"
}

main_loop() {
    if [ -n "${BITBEAST_BATTERY_PATH:-}" ]; then
        bat_path=$BITBEAST_BATTERY_PATH
    else
        bat_path=$(find_battery) || {
            # No battery found (desktop) — nothing to watch
            exit 0
        }
    fi

    while true; do
        capacity=$(cat "$bat_path/capacity" 2>/dev/null || echo "100")
        status=$(cat "$bat_path/status" 2>/dev/null || echo "Unknown")

        case "$status" in
            Charging)
                reset_low_flags
                if [ "$capacity" -ge "$FULL_THRESHOLD" ]; then
                    notify_full "$capacity"
                else
                    reset_full_flag
                fi
                ;;
            Full)
                reset_low_flags
                notify_full "$capacity"
                ;;
            Discharging)
                reset_full_flag
                if [ "$capacity" -le "$CRITICAL_THRESHOLD" ]; then
                    notify_critical "$capacity"
                elif [ "$capacity" -le "$LOW_THRESHOLD" ]; then
                    notify_low "$capacity"
                else
                    reset_low_flags
                fi
                ;;
            *)
                # Unknown status: keep current flags but do not notify
                ;;
        esac

        sleep "$INTERVAL"
    done
}

main_loop
