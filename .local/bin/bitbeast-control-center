#!/usr/bin/env python3
"""
BitBeast Control Center — macOS-style quick settings panel for Hyprland.

Usage:
  bitbeast-control-center                 # toggle panel
  bitbeast-control-center show            # open panel
  bitbeast-control-center show wifi       # open Wi-Fi details
  bitbeast-control-center show bluetooth  # open Bluetooth details
  bitbeast-control-center close           # close panel

Left column:
  Wi-Fi / Bluetooth / Power Mode rows with inline radio switches, Do Not
  Disturb, Screenshot, Screen Record, Beast theme swatches, grouped Brightness
  + Volume sliders, and quick actions (Airplane mode, Network settings, Lock).

Right column (merged from the old power popup):
  Clock with a greeting and live CPU / RAM / Disk / Battery meters,
  Notifications, Now Playing with album art, and session actions (Sleep /
  Log out / Restart / Shut down).

The Wi-Fi and Bluetooth rows open a macOS-style detail popover with a network
picker, password entry, Bluetooth scanning, pairing and battery information.

Clicking anywhere outside the panel — or pressing Escape — dismisses it: it
cancels an open password prompt first, then closes the detail popover, then
removes the panel itself.
"""

from __future__ import annotations

import hashlib
