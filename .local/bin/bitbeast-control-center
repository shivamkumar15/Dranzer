#!/usr/bin/env python3
"""
BitBeast Control Center — macOS-style quick settings panel for Hyprland.

Usage:
  bitbeast-control-center                 # toggle panel
  bitbeast-control-center show            # open panel
  bitbeast-control-center show wifi       # open Wi-Fi details
  bitbeast-control-center show bluetooth  # open Bluetooth details
  bitbeast-control-center close           # close panel

Cards:
  Wi-Fi / Bluetooth / Power Mode rows, Do Not Disturb, Screenshot, Screen
  Record, System Theme circles (beast themes), Brightness + Volume sliders.

The Wi-Fi and Bluetooth rows open a macOS-style detail popover with a network
picker, password entry, Bluetooth scanning, pairing and battery information.
"""

from __future__ import annotations

import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("Pango", "1.0")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

CACHE_DIR = Path.home() / ".cache" / "bitbeast"
SOCKET_PATH = CACHE_DIR / "cc.sock"
PID_FILE = CACHE_DIR / "cc.pid"

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
BEASTS_DIR = CONFIG_HOME / "bitbeasts"

DEBUG_LOG = os.environ.get("BITBEAST_CC_DEBUG", "")


def debug(message: str) -> None:
    if not DEBUG_LOG:
        return
    try:
        with open(DEBUG_LOG, "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {message}\n")
    except Exception:
        pass

# Fallback palette (Dranzer)
BG = "#150608"
PRIMARY = "#ff2d55"
ACCENT = "#ffd166"
TEXT = "#fff1dd"
SECONDARY = "#2c0d0f"

# Nerd Font glyphs
I_WIFI = "󰖩"
I_WIFI_OFF = "󰖪"
I_LOCK = "󰌾"
I_CHECK = "󰄬"
I_CHEVRON_RIGHT = "󰅂"
I_CHEVRON_LEFT = "󰅁"
I_REFRESH = "󰑐"
I_PLUS = "󰐕"
I_BLUETOOTH = "󰂯"
I_BLUETOOTH_CONNECTED = "󰂱"
I_BLUETOOTH_OFF = "󰂲"
I_HEADPHONES = "󰋋"
I_KEYBOARD = "󰌌"
I_MOUSE = "󰍽"
I_PHONE = "󰏲"
I_SPEAKER = "󰓃"
I_GAMEPAD = "󰊴"
I_LAPTOP = "󰌢"
I_MONITOR = "󰍹"
I_WATCH = "󰖟"
I_POWER = "󰓅"

BT_ICON_MAP = {
    "audio-headset": I_HEADPHONES,
    "audio-headphones": I_HEADPHONES,
    "audio-card": I_SPEAKER,
    "input-keyboard": I_KEYBOARD,
    "input-mouse": I_MOUSE,
    "phone": I_PHONE,
    "input-gaming": I_GAMEPAD,
    "computer": I_LAPTOP,
    "video-display": I_MONITOR,
    "watch": I_WATCH,
}

WIFI_SIGNAL_ICONS = (
    (75, "󰤨"),
    (50, "󰤥"),
    (25, "󰤢"),
    (0, "󰤟"),
)


def cmd(args: list[str], timeout: float = 3.0) -> str:
    try:
        return subprocess.check_output(
            args, stderr=subprocess.DEVNULL, timeout=timeout
        ).decode(errors="ignore").strip()
    except Exception:
        return ""


def run_cmd(args: list[str], timeout: float = 20.0) -> tuple[int, str]:
    """Run a command and return (returncode, combined output)."""
    try:
        p = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            errors="ignore",
        )
        out = "\n".join(part.strip() for part in (p.stdout, p.stderr) if part.strip())
        return p.returncode, out.strip()
    except subprocess.TimeoutExpired:
        return 124, "The request timed out"
    except FileNotFoundError:
        return 127, "Command not found"
    except Exception as exc:
        return 1, str(exc)


def spawn(args: str) -> None:
    subprocess.Popen(args, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_theme_colors() -> dict[str, str]:
    colors = {
        "bg": BG,
        "primary": PRIMARY,
        "secondary": SECONDARY,
        "accent": ACCENT,
        "text": TEXT,
    }
    conf = CONFIG_HOME / "bitbeast" / "current.conf"
    if not conf.is_file():
        conf = BEASTS_DIR / "dranzer" / "colors.conf"
    if conf.is_file():
        text = conf.read_text(encoding="utf-8", errors="ignore")
        for key in colors:
            m = re.search(rf"^\$\s*{key}\s*=\s*rgb\(([0-9a-fA-F]{{6}})\)", text, re.M)
            if m:
                colors[key] = f"#{m.group(1).lower()}"
    return colors


def hex_to_rgba(hex_color: str, alpha: float) -> str:
    h = hex_color.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"rgba({r}, {g}, {b}, {alpha})"


def _split_nmcli(line: str) -> list[str]:
    """Split an nmcli terse line on unescaped colons and unescape values."""
    fields: list[str] = []
    current: list[str] = []
    escaped = False
    for ch in line:
        if escaped:
            current.append(ch)
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(ch)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def _security_label(security: str) -> str:
    sec = security.strip()
    if sec in ("", "--"):
        return "Open"
    if "802.1X" in sec:
        return "Enterprise"
    if "WEP" in sec:
        return "WEP"
    return "Secured"


def wifi_signal_icon(signal: int) -> str:
    for threshold, icon in WIFI_SIGNAL_ICONS:
        if signal >= threshold:
            return icon
    return WIFI_SIGNAL_ICONS[-1][1]


# ── Wi-Fi helpers ────────────────────────────────────────────────────

def wifi_available() -> bool:
    return shutil.which("nmcli") is not None


def wifi_radio_on() -> bool:
    if not wifi_available():
        return False
    out = cmd(["nmcli", "-t", "-f", "WIFI", "radio"]).strip().lower()
    return out == "enabled"


def wifi_current_name() -> str:
    # The active connection profile is instant and does not depend on a scan.
    out = cmd(
        ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"],
        timeout=5,
    )
    for line in out.splitlines():
        parts = _split_nmcli(line)
        if len(parts) >= 2 and parts[1].strip() == "802-11-wireless":
            return parts[0].strip()

    # Fallback to the cached scan list (--rescan no keeps this instant too).
    out = cmd(
        [
            "nmcli", "-t", "-f", "ACTIVE,SSID", "device", "wifi", "list",
            "--rescan", "no",
        ],
        timeout=5,
    )
    for line in out.splitlines():
        parts = _split_nmcli(line)
        if len(parts) >= 2 and parts[0].strip() in ("*", "yes"):
            return parts[1].strip()
    return ""


def saved_wifi_profiles() -> set[str]:
    out = cmd(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], timeout=5)
    names: set[str] = set()
    for line in out.splitlines():
        parts = _split_nmcli(line)
        if len(parts) >= 2 and parts[1].strip() == "802-11-wireless":
            names.add(parts[0].strip())
    return names


def wifi_networks(rescan: bool = False) -> list[dict]:
    if not wifi_available():
        return []
    if rescan:
        cmd(["nmcli", "device", "wifi", "rescan"], timeout=8)
        # nmcli starts the rescan asynchronously; give it a moment before
        # reading the cached list.
        time.sleep(1.2)
    out = cmd(
        [
            "nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
            "device", "wifi", "list", "--rescan", "no",
        ],
        timeout=10,
    )
    profiles = saved_wifi_profiles()
    by_ssid: dict[str, dict] = {}
    for line in out.splitlines():
        parts = _split_nmcli(line)
        if len(parts) < 4:
            continue
        in_use = parts[0].strip() in ("*", "yes")
        ssid = parts[1].strip()
        if not ssid:
            continue
        try:
            signal = int(parts[2].strip())
        except ValueError:
            signal = 0
        security = parts[3].strip()
        net = {
            "ssid": ssid,
            "signal": signal,
            "security": security,
            "secure": security not in ("", "--"),
            "enterprise": "802.1X" in security,
            "in_use": in_use,
            "saved": ssid in profiles,
        }
        previous = by_ssid.get(ssid)
        if previous is None:
            by_ssid[ssid] = net
            continue
        # Prefer the active AP, otherwise the strongest one.
        if net["in_use"] and not previous["in_use"]:
            by_ssid[ssid] = net
        elif net["signal"] > previous["signal"] and not previous["in_use"]:
            by_ssid[ssid] = net
        by_ssid[ssid]["saved"] = previous["saved"] or net["saved"]

    networks = list(by_ssid.values())
    networks.sort(
        key=lambda n: (
            not n["in_use"],
            not n["saved"],
            -int(n["signal"]),
            n["ssid"].lower(),
        )
    )
    return networks


def _clean_error(output: str, fallback: str) -> str:
    text = output.strip()
    if not text:
        return fallback
    for prefix in ("Error: ", "error: "):
        if text.startswith(prefix):
            text = text[len(prefix):]
    # nmcli can return several lines; the last one is usually the useful one.
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    return lines[-1] if lines else fallback


def wifi_connect(ssid: str, password: str = "", saved: bool = False,
                 hidden: bool = False) -> tuple[bool, str]:
    if not wifi_available():
        return False, "NetworkManager is not available"

    if saved and not password:
        rc, out = run_cmd(["nmcli", "connection", "up", "id", ssid], timeout=30)
        if rc == 0:
            return True, ""
        # A saved profile whose name differs from the SSID can still work via
        # the device-level connect below.

    args = ["nmcli", "device", "wifi", "connect", ssid]
    if password:
        args += ["password", password]
    if hidden:
        args += ["hidden", "yes"]
    rc, out = run_cmd(args, timeout=45)
    if rc == 0:
        return True, ""
    return False, _clean_error(out, "Could not connect to this network")


def wifi_disconnect() -> tuple[bool, str]:
    name = wifi_current_name()
    if not name:
        return True, ""
    rc, out = run_cmd(["nmcli", "connection", "down", "id", name], timeout=20)
    if rc == 0:
        return True, ""
    return False, _clean_error(out, "Could not disconnect")


# ── Bluetooth helpers ────────────────────────────────────────────────

def bt_available() -> bool:
    return shutil.which("bluetoothctl") is not None


def bt_powered() -> bool:
    if not bt_available():
        return False
    return "Powered: yes" in cmd(["bluetoothctl", "show"], timeout=5)


def _parse_bt_devices(output: str) -> list[dict]:
    devices = []
    for line in output.splitlines():
        parts = line.strip().split(" ", 2)
        if len(parts) >= 3 and parts[0].lower() == "device":
            devices.append({"mac": parts[1], "name": parts[2].strip() or parts[1]})
    return devices


def bt_connected_names() -> list[str]:
    if not bt_available():
        return []
    out = cmd(["bluetoothctl", "devices", "Connected"], timeout=5)
    return [d["name"] for d in _parse_bt_devices(out)]


def bt_device_icon(name: str) -> str:
    n = name.lower()
    if any(k in n for k in ("headphone", "headset", "airpod", "buds", "earbud", "wh-", "wf-")):
        return I_HEADPHONES
    if "keyboard" in n or "keychron" in n:
        return I_KEYBOARD
    if "mouse" in n or "trackpad" in n:
        return I_MOUSE
    if "phone" in n or "iphone" in n or "galaxy" in n or "pixel" in n:
        return I_PHONE
    if "speaker" in n or "soundbar" in n or "jbl" in n or "bose" in n:
        return I_SPEAKER
    if "gamepad" in n or "controller" in n or "dualsense" in n or "xbox" in n:
        return I_GAMEPAD
    if "laptop" in n or "macbook" in n or "notebook" in n:
        return I_LAPTOP
    if "watch" in n:
        return I_WATCH
    if "tv" in n or "monitor" in n:
        return I_MONITOR
    return I_BLUETOOTH


def bt_devices() -> list[dict]:
    if not bt_available():
        return []
    known = _parse_bt_devices(cmd(["bluetoothctl", "devices"], timeout=8))
    connected = {
        d["mac"] for d in _parse_bt_devices(
            cmd(["bluetoothctl", "devices", "Connected"], timeout=8)
        )
    }
    paired = {
        d["mac"] for d in _parse_bt_devices(
            cmd(["bluetoothctl", "devices", "Paired"], timeout=8)
        )
    }

    devices = []
    for device in known:
        mac = device["mac"]
        device["connected"] = mac in connected
        device["paired"] = mac in paired or mac in connected
        # BLE advertisements often have no name. Bluetoothctl falls back to the
        # MAC address, which would fill the panel with meaningless rows.
        compact_name = device["name"].replace(":", "").replace("-", "").lower()
        compact_mac = mac.replace(":", "").replace("-", "").lower()
        if not device["connected"] and not device["paired"] and compact_name == compact_mac:
            continue

        device["icon"] = bt_device_icon(device["name"])
        device["battery"] = None
        if device["connected"] or device["paired"]:
            info = cmd(["bluetoothctl", "info", mac], timeout=5)
            icon = re.search(r"^\s*Icon:\s*(\S+)", info, re.M)
            if icon and icon.group(1) in BT_ICON_MAP:
                device["icon"] = BT_ICON_MAP[icon.group(1)]
            if device["connected"]:
                m = re.search(
                    r"Battery Percentage:\s*(?:0x[0-9a-fA-F]+\s*)?"
                    r"(?:\(0x[0-9a-fA-F]+\)\s*)?(\d+)",
                    info,
                )
                if m:
                    device["battery"] = int(m.group(1))
        devices.append(device)

    devices.sort(
        key=lambda d: (
            not d["connected"],
            not d["paired"],
            d["name"].lower(),
        )
    )
    return devices


def bt_scan(duration: int = 8) -> tuple[bool, str]:
    if not bt_available():
        return False, "BlueZ is not available"
    rc, out = run_cmd(
        ["bluetoothctl", "--timeout", str(duration), "scan", "on"],
        timeout=duration + 5,
    )
    if rc == 0:
        return True, ""
    return False, _clean_error(out, "Could not scan for Bluetooth devices")


def _bt_failed(output: str) -> bool:
    lowered = output.lower()
    return any(
        marker in lowered
        for marker in (
            "failed to connect",
            "not available",
            "no default controller",
            "does not exist",
            "not ready",
        )
    )


def bt_connect(mac: str, paired: bool) -> tuple[bool, str]:
    if not bt_available():
        return False, "BlueZ is not available"

    output = ""
    if not paired:
        rc, out = run_cmd(
            ["bluetoothctl", "--timeout", "25", "pair", mac], timeout=35
        )
        output += out
        if rc != 0 and "alreadyexists" not in out.lower() and _bt_failed(out):
            return False, _clean_error(out, "Pairing failed")

    rc, out = run_cmd(
        ["bluetoothctl", "--timeout", "20", "trust", mac], timeout=25
    )
    output += "\n" + out

    rc, out = run_cmd(
        ["bluetoothctl", "--timeout", "25", "connect", mac], timeout=35
    )
    output += "\n" + out
    if rc != 0 or _bt_failed(out):
        return False, _clean_error(out, "Could not connect to this device")
    return True, ""


def bt_disconnect(mac: str) -> tuple[bool, str]:
    if not bt_available():
        return False, "BlueZ is not available"
    rc, out = run_cmd(
        ["bluetoothctl", "--timeout", "15", "disconnect", mac], timeout=25
    )
    if rc != 0 or _bt_failed(out):
        return False, _clean_error(out, "Could not disconnect")
    return True, ""


def bt_set_power(on: bool) -> tuple[bool, str]:
    if not bt_available():
        return False, "BlueZ is not available"
    if on:
        spawn("rfkill unblock bluetooth")
    rc, out = run_cmd(
        ["bluetoothctl", "power", "on" if on else "off"], timeout=15
    )
    if rc != 0:
        return False, _clean_error(out, "Could not change Bluetooth power")
    return True, ""


def wifi_set_power(on: bool) -> tuple[bool, str]:
    if not wifi_available():
        return False, "NetworkManager is not available"
    rc, out = run_cmd(["nmcli", "radio", "wifi", "on" if on else "off"], timeout=15)
    if rc != 0:
        return False, _clean_error(out, "Could not change Wi-Fi power")
    return True, ""


# ── Other system helpers ─────────────────────────────────────────────

POWER_PROFILES = ["balanced", "performance", "power-saver"]


def power_profile() -> str:
    p = cmd(["powerprofilesctl", "get"]).lower()
    return p or "balanced"


def power_cycle() -> str:
    current = power_profile()
    try:
        idx = (POWER_PROFILES.index(current) + 1) % len(POWER_PROFILES)
    except ValueError:
        idx = 0
    nxt = POWER_PROFILES[idx]
    spawn(f"powerprofilesctl set {nxt}")
    return nxt


def dnd_state() -> bool:
    return cmd(["swaync-client", "--get-dnd"]).strip().lower() == "true"


def dnd_toggle() -> None:
    spawn("swaync-client --toggle-dnd")


def recording_active() -> bool:
    return bool(cmd(["pgrep", "-x", "wf-recorder"]))


def screenshot() -> None:
    shots = Path.home() / "Pictures" / "Screenshots"
    spawn(
        f"mkdir -p '{shots}' && grim -g \"$(slurp)\" "
        f"'{shots}/shot-$(date +%Y%m%d-%H%M%S).png'"
    )


def screen_record() -> None:
    if recording_active():
        spawn("pkill -x wf-recorder")
        return
    vids = Path.home() / "Videos"
    spawn(
        f"mkdir -p '{vids}' && wf-recorder -c h264 -f "
        f"'{vids}/rec-$(date +%Y%m%d-%H%M%S).mkv'"
    )


def get_brightness() -> int:
    out = cmd(["brightnessctl", "-m"])
    parts = out.split(",")
    if len(parts) >= 4:
        try:
            return int(parts[3].rstrip("%"))
        except ValueError:
            pass
    return 50


def set_brightness(pct: int) -> None:
    spawn(f"brightnessctl -q set {int(pct)}%")


def get_volume() -> int:
    out = cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    m = re.search(r"Volume:\s*([0-9.]+)", out)
    return min(100, int(round(float(m.group(1)) * 100))) if m else 0


def set_volume(pct: int) -> None:
    spawn(f"wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ {int(pct)}%")


def list_beast_themes() -> list[tuple[str, str, str]]:
    """[(name, primary_hex, accent_hex)] sorted."""
    themes = []
    if BEASTS_DIR.is_dir():
        for d in sorted(BEASTS_DIR.iterdir()):
            conf = d / "colors.conf"
            if not conf.is_file():
                continue
            text = conf.read_text(encoding="utf-8", errors="ignore")

            def pick(key: str, fallback: str) -> str:
                m = re.search(rf"^\$\s*{key}\s*=\s*rgb\(([0-9a-fA-F]{{6}})\)", text, re.M)
                return f"#{m.group(1).lower()}" if m else fallback

            themes.append((d.name, pick("primary", "#888888"), pick("accent", "#ffffff")))
    return themes


def current_beast_theme() -> str:
    f = CONFIG_HOME / "bitbeast" / "current.theme"
    return f.read_text().strip() if f.is_file() else ""


# ── Single-instance IPC ──────────────────────────────────────────────

def send_command(message: str) -> bool:
    if not SOCKET_PATH.exists():
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.settimeout(0.25)
            s.sendto((message + "\n").encode(), str(SOCKET_PATH))
            return True
    except Exception:
        SOCKET_PATH.unlink(missing_ok=True)
        return False


# ── UI helpers ───────────────────────────────────────────────────────

def set_hand_cursor(widget: Gtk.Widget) -> None:
    def on_realize(w):
        try:
            w.get_window().set_cursor(
                Gdk.Cursor.new_from_name(w.get_display(), "pointer")
            )
        except Exception:
            pass

    widget.connect("realize", on_realize)


def clear_box(box: Gtk.Box) -> None:
    for child in box.get_children():
        box.remove(child)
        child.destroy()


class ConnectionDetail(Gtk.Box):
    """macOS-style Wi-Fi / Bluetooth popover shown left of the main panel."""

    def __init__(self, cc: "ControlCenter") -> None:
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.set_name("cc-panel")
        self.set_size_request(372, -1)
        self.cc = cc
        self.mode = "wifi"
        self._networks: list[dict] = []
        self._devices: list[dict] = []
        self._empty_label: Gtk.Label | None = None
        self._wifi_sig = None
        self._bt_sig = None
        self._sync_switch = False
        self._action_text: str | None = None
        self._scanning = False
        self._error_text: str | None = None
        self._error_token = 0
        self._auth_ssid = ""
        self._auth_security = ""
        self._auth_hidden = False
        self._auth_busy = False
        self._initial_scan_done = False
        self._reset_scroll = True
        self._build()

    # -- construction -------------------------------------------------

    def _build(self) -> None:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.set_valign(Gtk.Align.CENTER)

        back = Gtk.EventBox()
        back.set_name("cc-icon-btn")
        back_label = Gtk.Label(label=I_CHEVRON_LEFT)
        back_label.set_name("cc-icon")
        back_label.set_valign(Gtk.Align.CENTER)
        back.add(back_label)
        back.connect("button-press-event", lambda *_: self.cc.close_detail() or True)
        back.set_tooltip_text("Back")
        set_hand_cursor(back)
        header.pack_start(back, False, False, 0)

        self.title = Gtk.Label(label="Wi-Fi")
        self.title.set_name("cc-detail-title")
        self.title.set_xalign(0.0)
        header.pack_start(self.title, True, True, 0)

        self.power_switch = Gtk.Switch()
        self.power_switch.set_valign(Gtk.Align.CENTER)
        self.power_switch.connect("notify::active", self._on_switch)
        header.pack_end(self.power_switch, False, False, 0)

        self.pack_start(header, False, False, 0)

        # Status card -------------------------------------------------
        self.status_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.status_card.set_name("cc-status-card")
        status_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.status_title = Gtk.Label(label="Wi-Fi is on")
        self.status_title.set_name("cc-detail-status")
        self.status_title.set_xalign(0.0)
        self.status_sub = Gtk.Label(label="Not connected")
        self.status_sub.set_name("cc-sub")
        self.status_sub.set_xalign(0.0)
        self.status_sub.set_ellipsize(Pango.EllipsizeMode.END)
        status_text.pack_start(self.status_title, False, False, 0)
        status_text.pack_start(self.status_sub, False, False, 0)
        self.status_card.pack_start(status_text, True, True, 0)

        self.disconnect_btn = Gtk.Button(label="Disconnect")
        self.disconnect_btn.set_name("cc-pill")
        self.disconnect_btn.set_relief(Gtk.ReliefStyle.NONE)
        self.disconnect_btn.set_valign(Gtk.Align.CENTER)
        self.disconnect_btn.set_no_show_all(True)
        self.disconnect_btn.connect("clicked", lambda *_: self._disconnect_wifi())
        self.status_card.pack_end(self.disconnect_btn, False, False, 0)

        self.pack_start(self.status_card, False, False, 0)

        # Activity row ------------------------------------------------
        self.activity = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.activity.set_no_show_all(True)
        self.activity_spinner = Gtk.Spinner()
        self.activity_spinner.set_valign(Gtk.Align.CENTER)
        self.activity_spinner.set_no_show_all(True)
        self.activity_label = Gtk.Label(label="")
        self.activity_label.set_name("cc-sub")
        self.activity_label.set_xalign(0.0)
        self.activity_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.activity.pack_start(self.activity_spinner, False, False, 0)
        self.activity.pack_start(self.activity_label, True, True, 0)
        self.pack_start(self.activity, False, False, 0)

        # Stack: list / auth -----------------------------------------
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(170)

        self.list_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        section = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.section_title = Gtk.Label(label="Networks")
        self.section_title.set_name("cc-section-title")
        self.section_title.set_xalign(0.0)
        section.pack_start(self.section_title, True, True, 0)

        self.refresh_btn = Gtk.EventBox()
        self.refresh_btn.set_name("cc-icon-btn")
        refresh_label = Gtk.Label(label=I_REFRESH)
        refresh_label.set_name("cc-icon")
        self.refresh_btn.add(refresh_label)
        self.refresh_btn.connect("button-press-event", lambda *_: self._on_refresh() or True)
        set_hand_cursor(self.refresh_btn)
        section.pack_end(self.refresh_btn, False, False, 0)
        self.list_page.pack_start(section, False, False, 0)

        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_min_content_height(360)
        self.scrolled.set_max_content_height(360)
        self.scrolled.set_propagate_natural_height(False)
        self.scrolled.set_overlay_scrolling(True)
        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.scrolled.add(self.list_box)
        self.list_page.pack_start(self.scrolled, True, True, 0)

        self.footer = Gtk.EventBox()
        self.footer.set_name("cc-net-row")
        self.footer.set_no_show_all(True)
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.footer_icon = Gtk.Label(label=I_PLUS)
        self.footer_icon.set_name("cc-net-icon")
        self.footer_label = Gtk.Label(label="Other Network…")
        self.footer_label.set_name("cc-net-name")
        self.footer_label.set_xalign(0.0)
        footer_box.pack_start(self.footer_icon, False, False, 0)
        footer_box.pack_start(self.footer_label, True, True, 0)
        self.footer.add(footer_box)
        self.footer.connect("button-press-event", lambda *_: self._show_auth("", "", True) or True)
        set_hand_cursor(self.footer)
        self.footer_box = footer_box
        self.list_page.pack_start(self.footer, False, False, 0)

        self.auth_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        self.stack.add_named(self.list_page, "list")
        self.stack.add_named(self.auth_page, "auth")
        self.pack_start(self.stack, True, True, 0)

    # -- mode / state -------------------------------------------------

    def set_mode(self, mode: str) -> None:
        debug(f"set_mode {mode}")
        self.mode = mode
        self._error_text = None
        self._error_token += 1
        self._action_text = None
        self._initial_scan_done = False
        self._wifi_sig = None
        self._bt_sig = None
        self._reset_scroll = True
        self._show_list_page()
        self._refresh_activity()

        if mode == "wifi":
            if "networks" in self.cc.state:
                self._networks = (
                    self.cc.state["networks"] if self.cc.state.get("wifi_on") else []
                )
            self.title.set_text("Wi-Fi")
            self.section_title.set_text("Networks")
            self.footer_icon.set_text(I_PLUS)
            self.footer_label.set_text("Other Network…")
            self.footer_box.show_all()
            self.footer.show()
            self.refresh_btn.set_tooltip_text("Scan for networks")
            self._rebuild_list(self._networks, self._wifi_row)
        else:
            if "devices" in self.cc.state:
                self._devices = (
                    self.cc.state["devices"] if self.cc.state.get("bt_on") else []
                )
            self.title.set_text("Bluetooth")
            self.section_title.set_text("Devices")
            self.footer.hide()
            self.refresh_btn.set_tooltip_text("Scan for devices")
            self._rebuild_list(self._devices, self._bt_row)

        self._sync_from_state()
        self.list_page.queue_resize()

    def apply_state(self, state: dict) -> None:
        self.cc.state = state
        self._sync_from_state()
        if "networks" in state and self.mode == "wifi":
            self._update_wifi_list(state["networks"] if state.get("wifi_on") else [])
        if "devices" in state and self.mode == "bluetooth":
            self._update_bt_list(state["devices"] if state.get("bt_on") else [])

        if not self._initial_scan_done and not self._scanning and not self._action_text:
            if self.mode == "wifi" and state.get("wifi_on"):
                self._initial_scan_done = True
                GLib.timeout_add(250, self._start_wifi_rescan)
            elif self.mode == "bluetooth" and state.get("bt_on"):
                self._initial_scan_done = True
                GLib.timeout_add(250, self._start_bt_scan)

    def _sync_from_state(self) -> None:
        st = self.cc.state
        if self.mode == "wifi":
            if "wifi_on" not in st:
                self.status_title.set_text("Wi-Fi")
                self.status_sub.set_text("Checking status…")
                self.disconnect_btn.hide()
                self.power_switch.set_sensitive(False)
                self._refresh_empty_text()
                return
            available = st.get("wifi_available", True)
            powered = bool(st.get("wifi_on"))
            name = st.get("wifi_name", "")
            self.power_switch.set_sensitive(available)
            if not self._action_text:
                self._set_switch(powered)
            if not available:
                self.status_title.set_text("Wi-Fi unavailable")
                self.status_sub.set_text("NetworkManager is not running")
                self.disconnect_btn.hide()
            elif powered:
                self.status_title.set_text("Wi-Fi is on")
                if name:
                    self.status_sub.set_text(f"Connected to {name}")
                    self.disconnect_btn.show()
                else:
                    self.status_sub.set_text("Not connected")
                    self.disconnect_btn.hide()
            else:
                self.status_title.set_text("Wi-Fi is off")
                self.status_sub.set_text("Turn on Wi-Fi to see networks")
                self.disconnect_btn.hide()
        else:
            if "bt_on" not in st:
                self.status_title.set_text("Bluetooth")
                self.status_sub.set_text("Checking status…")
                self.disconnect_btn.hide()
                self.power_switch.set_sensitive(False)
                self._refresh_empty_text()
                return
            available = st.get("bt_available", True)
            powered = bool(st.get("bt_on"))
            names = st.get("bt_names") or []
            self.disconnect_btn.hide()
            self.power_switch.set_sensitive(available)
            if not self._action_text:
                self._set_switch(powered)
            if not available:
                self.status_title.set_text("Bluetooth unavailable")
                self.status_sub.set_text("BlueZ is not installed")
            elif powered:
                self.status_title.set_text("Bluetooth is on")
                if names:
                    if len(names) == 1:
                        self.status_sub.set_text(f"Connected to {names[0]}")
                    else:
                        self.status_sub.set_text(f"Connected to {len(names)} devices")
                else:
                    self.status_sub.set_text("Not connected")
            else:
                self.status_title.set_text("Bluetooth is off")
                self.status_sub.set_text("Turn on Bluetooth to see devices")
        self._refresh_empty_text()

    def _set_switch(self, active: bool) -> None:
        self._sync_switch = True
        try:
            self.power_switch.set_active(active)
        finally:
            self._sync_switch = False

    def _on_switch(self, switch: Gtk.Switch, _param) -> None:
        if self._sync_switch or self._action_text:
            return
        self._set_radio(bool(switch.get_active()))

    # -- activity -----------------------------------------------------

    def _refresh_activity(self) -> None:
        text = None
        spinning = False
        error = False
        if self._action_text:
            text = self._action_text
            spinning = True
        elif self._error_text:
            text = self._error_text
            error = True
        elif self._scanning:
            text = "Scanning for Bluetooth devices…" if self.mode == "bluetooth" else "Scanning for networks…"
            spinning = True

        if not text:
            self.activity_spinner.stop()
            self.activity.hide()
            self._refresh_empty_text()
            return

        self.activity_label.set_text(text)
        ctx = self.activity_label.get_style_context()
        if error:
            ctx.add_class("cc-error")
        else:
            ctx.remove_class("cc-error")
        if spinning:
            self.activity_spinner.start()
            self.activity_spinner.show()
        else:
            self.activity_spinner.stop()
            self.activity_spinner.hide()
        self.activity.show_all()
        self._refresh_empty_text()

    def _set_action(self, text: str | None) -> None:
        self._action_text = text
        self._refresh_activity()

    def _flash_error(self, text: str) -> None:
        self._error_text = text
        self._error_token += 1
        token = self._error_token
        self._refresh_activity()

        def clear():
            if token == self._error_token:
                self._error_text = None
                self._refresh_activity()
            return False

        GLib.timeout_add(6500, clear)

    # -- list rendering ----------------------------------------------

    def _show_list_page(self) -> None:
        self.stack.set_visible_child_name("list")
        self.cc.set_detail_keyboard(False)

    def auth_open(self) -> bool:
        return self.stack.get_visible_child_name() == "auth"

    def _update_wifi_list(self, networks: list[dict]) -> None:
        sig = tuple(
            (
                n["ssid"],
                n["signal"] // 10,
                n["security"],
                n["in_use"],
                n["saved"],
            )
            for n in networks
        )
        if sig == self._wifi_sig:
            return
        self._wifi_sig = sig
        self._networks = networks
        self._rebuild_list(networks, self._wifi_row)

    def _update_bt_list(self, devices: list[dict]) -> None:
        sig = tuple(
            (
                d["mac"],
                d["connected"],
                d["paired"],
                d["battery"],
                d["name"],
            )
            for d in devices
        )
        if sig == self._bt_sig:
            return
        self._bt_sig = sig
        self._devices = devices
        self._rebuild_list(devices, self._bt_row)

    def _empty_text(self) -> str:
        st = self.cc.state
        if self.mode == "wifi":
            if "wifi_on" not in st:
                return "Loading networks…"
            if not st.get("wifi_on"):
                return "Wi-Fi is off\nTurn it on to see nearby networks"
            if self._scanning:
                return "Looking for nearby networks…"
            return "No networks found\nTry scanning again"
        if "bt_on" not in st:
            return "Loading devices…"
        if not st.get("bt_on"):
            return "Bluetooth is off\nTurn it on to see your devices"
        if self._scanning:
            return "Looking for nearby devices…"
        return "No devices found\nPut a device in pairing mode and scan"

    def _refresh_empty_text(self) -> None:
        if self._empty_label is not None:
            self._empty_label.set_text(self._empty_text())

    def _rebuild_list(self, items: list[dict], row_factory) -> None:
        adjustment = self.scrolled.get_vadjustment()
        if self._reset_scroll:
            scroll_pos = 0
            self._reset_scroll = False
        else:
            scroll_pos = adjustment.get_value()
        clear_box(self.list_box)
        self._empty_label = None

        if not items:
            self._empty_label = Gtk.Label(label=self._empty_text())
            self._empty_label.set_name("cc-empty")
            self._empty_label.set_line_wrap(True)
            self._empty_label.set_justify(Gtk.Justification.CENTER)
            self.list_box.pack_start(self._empty_label, False, False, 10)
            self.list_box.show_all()
        else:
            for item in items:
                self.list_box.pack_start(row_factory(item), False, False, 0)
            self.list_box.show_all()

        def restore():
            try:
                adjustment.set_value(min(scroll_pos, adjustment.get_upper() - adjustment.get_page_size()))
            except Exception:
                pass
            return False

        GLib.idle_add(restore)

    def _wifi_row(self, net: dict) -> Gtk.EventBox:
        ev = Gtk.EventBox()
        ev.set_name("cc-net-row-active" if net["in_use"] else "cc-net-row")
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        icon = Gtk.Label(label=wifi_signal_icon(int(net["signal"])))
        icon.set_name("cc-net-icon")
        if net["in_use"]:
            icon.get_style_context().add_class("cc-net-icon-active")
        icon.set_valign(Gtk.Align.CENTER)
        h.pack_start(icon, False, False, 0)

        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mid.set_valign(Gtk.Align.CENTER)
        name = Gtk.Label(label=net["ssid"])
        name.set_name("cc-net-name")
        name.set_xalign(0.0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(28)
        mid.pack_start(name, False, False, 0)

        if net["in_use"]:
            sub_text = "Connected"
        elif net["saved"]:
            sub_text = "Saved"
        else:
            sub_text = _security_label(net["security"])
        sub_text += f" · {net['signal']}%"
        sub = Gtk.Label(label=sub_text)
        sub.set_name("cc-net-sub")
        sub.set_xalign(0.0)
        mid.pack_start(sub, False, False, 0)
        h.pack_start(mid, True, True, 0)

        right = Gtk.Label(
            label=I_CHECK if net["in_use"] else (I_LOCK if net["secure"] else "")
        )
        right.set_name("cc-net-side")
        right.set_valign(Gtk.Align.CENTER)
        h.pack_end(right, False, False, 4)

        ev.add(h)
        if not net["in_use"]:
            ev.connect("button-press-event", self._wifi_row_clicked, net)
            set_hand_cursor(ev)
        ev.set_tooltip_text(
            f"{net['ssid']} — {_security_label(net['security'])}"
            + (" (connected)" if net["in_use"] else "")
        )
        return ev

    def _bt_row(self, device: dict) -> Gtk.EventBox:
        ev = Gtk.EventBox()
        ev.set_name("cc-net-row-active" if device["connected"] else "cc-net-row")
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        icon = Gtk.Label(label=device["icon"])
        icon.set_name("cc-net-icon")
        if device["connected"]:
            icon.get_style_context().add_class("cc-net-icon-active")
        icon.set_valign(Gtk.Align.CENTER)
        h.pack_start(icon, False, False, 0)

        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mid.set_valign(Gtk.Align.CENTER)
        name = Gtk.Label(label=device["name"])
        name.set_name("cc-net-name")
        name.set_xalign(0.0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(28)
        mid.pack_start(name, False, False, 0)

        if device["connected"]:
            sub_text = "Connected"
            if device["battery"] is not None:
                sub_text += f" · {device['battery']}%"
        elif device["paired"]:
            sub_text = "Paired"
        else:
            sub_text = "Nearby"
        sub = Gtk.Label(label=sub_text)
        sub.set_name("cc-net-sub")
        sub.set_xalign(0.0)
        mid.pack_start(sub, False, False, 0)
        h.pack_start(mid, True, True, 0)

        right = Gtk.Label(label=I_CHECK if device["connected"] else "")
        right.set_name("cc-net-side")
        right.set_valign(Gtk.Align.CENTER)
        h.pack_end(right, False, False, 4)

        ev.add(h)
        ev.connect("button-press-event", self._bt_row_clicked, device)
        ev.set_tooltip_text(
            f"{device['name']} — click to "
            + ("disconnect" if device["connected"] else "connect")
        )
        set_hand_cursor(ev)
        return ev

    # -- clicks -------------------------------------------------------

    def _wifi_row_clicked(self, _widget, _event, net: dict) -> bool:
        if self._action_text:
            return True
        if net["in_use"]:
            return True
        if net["enterprise"] and not net["saved"]:
            self._show_enterprise(net["ssid"])
        elif net["secure"] and not net["saved"]:
            self._show_auth(net["ssid"], net["security"])
        else:
            self._connect_wifi(net["ssid"], saved=net["saved"])
        return True

    def _bt_row_clicked(self, _widget, _event, device: dict) -> bool:
        if self._action_text:
            return True
        self._toggle_bt_device(device)
        return True

    # -- actions ------------------------------------------------------

    def _set_radio(self, on: bool) -> None:
        mode = self.mode
        label = "Wi-Fi" if mode == "wifi" else "Bluetooth"
        if on:
            self._initial_scan_done = False
        self._set_action(f"Turning {label} {'on' if on else 'off'}…")

        def work():
            if mode == "wifi":
                result = wifi_set_power(on)
            else:
                result = bt_set_power(on)
            GLib.idle_add(done, result)

        def done(result):
            ok, message = result
            self._set_action(None)
            if not ok:
                self._flash_error(message)
                self._sync_from_state()
            self.cc.refresh_states()
            return False

        threading.Thread(target=work, daemon=True).start()

    def _connect_wifi(self, ssid: str, password: str = "", saved: bool = False,
                      hidden: bool = False) -> None:
        self._set_action(f"Connecting to {ssid or 'network'}…")

        def work():
            result = wifi_connect(ssid, password=password, saved=saved, hidden=hidden)
            GLib.idle_add(done, result)

        def done(result):
            ok, message = result
            self._set_action(None)
            self._set_auth_busy(False)
            if ok:
                self._show_list_page()
                self.cc.refresh_states()
            else:
                if self.stack.get_visible_child_name() == "auth":
                    self._set_auth_error(message)
                else:
                    self._flash_error(message)
                self.cc.refresh_states()
            return False

        threading.Thread(target=work, daemon=True).start()

    def _disconnect_wifi(self) -> None:
        if self._action_text:
            return
        self._set_action("Disconnecting…")

        def work():
            result = wifi_disconnect()
            GLib.idle_add(done, result)

        def done(result):
            ok, message = result
            self._set_action(None)
            if not ok:
                self._flash_error(message)
            self.cc.refresh_states()
            return False

        threading.Thread(target=work, daemon=True).start()

    def _toggle_bt_device(self, device: dict) -> None:
        connected = device["connected"]
        name = device["name"]
        self._set_action(
            ("Disconnecting from " if connected else "Connecting to ") + name + "…"
        )

        def work():
            if connected:
                result = bt_disconnect(device["mac"])
            else:
                result = bt_connect(device["mac"], device["paired"])
            GLib.idle_add(done, result)

        def done(result):
            ok, message = result
            self._set_action(None)
            if not ok:
                self._flash_error(message)
            self.cc.refresh_states()
            return False

        threading.Thread(target=work, daemon=True).start()

    def _start_wifi_rescan(self) -> bool:
        if self._scanning or self._action_text:
            return False
        if os.environ.get("BITBEAST_CC_NO_SCAN"):
            return False
        if not self.cc.state.get("wifi_on", self.power_switch.get_active()):
            return False
        self._scanning = True
        self._refresh_activity()

        def work():
            networks = wifi_networks(rescan=True)
            GLib.idle_add(done, networks)

        def done(networks):
            self._scanning = False
            self._refresh_activity()
            self._update_wifi_list(networks)
            return False

        threading.Thread(target=work, daemon=True).start()
        return False

    def _start_bt_scan(self) -> bool:
        if self._scanning or self._action_text:
            return False
        if os.environ.get("BITBEAST_CC_NO_SCAN"):
            return False
        if not self.cc.state.get("bt_on", self.power_switch.get_active()):
            return False
        debug("bt scan start")
        self._scanning = True
        self._refresh_activity()

        def work():
            bt_scan(8)
            devices = bt_devices()
            debug(f"bt scan done ({len(devices)} devices)")
            GLib.idle_add(done, devices)

        def done(devices):
            self._scanning = False
            self._refresh_activity()
            self._update_bt_list(devices)
            self.cc.refresh_states()
            return False

        threading.Thread(target=work, daemon=True).start()
        return False

    def _on_refresh(self) -> bool:
        if self.mode == "wifi":
            self._start_wifi_rescan()
        else:
            self._start_bt_scan()
        return True

    # -- join form ----------------------------------------------------

    def _show_auth(self, ssid: str, security: str, hidden: bool = False) -> None:
        self._auth_ssid = ssid
        self._auth_security = security
        self._auth_hidden = hidden
        self._auth_busy = False
        self._error_text = None
        self._error_token += 1
        clear_box(self.auth_page)

        title = Gtk.Label(
            label=f"Join “{ssid}”" if ssid else "Join Other Network"
        )
        title.set_name("cc-detail-title")
        title.set_xalign(0.0)
        title.set_line_wrap(True)
        self.auth_page.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label=(
                "Enter the network name and password."
                if hidden
                else f"{_security_label(security)} network"
            )
        )
        subtitle.set_name("cc-sub")
        subtitle.set_xalign(0.0)
        subtitle.set_line_wrap(True)
        self.auth_page.pack_start(subtitle, False, False, 0)

        self._auth_ssid_entry = None
        if hidden:
            ssid_label = Gtk.Label(label="Network Name")
            ssid_label.set_name("cc-field-label")
            ssid_label.set_xalign(0.0)
            self.auth_page.pack_start(ssid_label, False, False, 0)
            self._auth_ssid_entry = Gtk.Entry()
            self._auth_ssid_entry.set_placeholder_text("Network name (SSID)")
            self._auth_ssid_entry.set_activates_default(False)
            self.auth_page.pack_start(self._auth_ssid_entry, False, False, 0)

        password_label = Gtk.Label(
            label="Password" if not hidden else "Password (optional for open networks)"
        )
        password_label.set_name("cc-field-label")
        password_label.set_xalign(0.0)
        self.auth_page.pack_start(password_label, False, False, 0)
        self._auth_password_entry = Gtk.Entry()
        self._auth_password_entry.set_placeholder_text(
            "Password (leave blank if open)" if hidden else "Password"
        )
        self._auth_password_entry.set_visibility(False)
        self._auth_password_entry.set_invisible_char("●")
        self._auth_password_entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self._auth_password_entry.connect("activate", lambda *_: self._submit_auth())
        self.auth_page.pack_start(self._auth_password_entry, False, False, 0)

        self._auth_error = Gtk.Label(label="")
        self._auth_error.set_name("cc-error")
        self._auth_error.set_xalign(0.0)
        self._auth_error.set_line_wrap(True)
        self._auth_error.set_no_show_all(True)
        self.auth_page.pack_start(self._auth_error, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cancel = Gtk.Button(label="Cancel")
        cancel.set_name("cc-pill")
        cancel.set_relief(Gtk.ReliefStyle.NONE)
        cancel.connect("clicked", lambda *_: self._cancel_auth())
        actions.pack_end(cancel, False, False, 0)

        self._auth_join = Gtk.Button(label="Join")
        self._auth_join.set_name("cc-primary")
        self._auth_join.set_relief(Gtk.ReliefStyle.NONE)
        self._auth_join.connect("clicked", lambda *_: self._submit_auth())
        actions.pack_end(self._auth_join, False, False, 0)

        self._auth_spinner = Gtk.Spinner()
        self._auth_spinner.set_no_show_all(True)
        actions.pack_end(self._auth_spinner, False, False, 0)
        self.auth_page.pack_end(actions, False, False, 0)

        self.auth_page.show_all()
        self._auth_error.hide()
        self._auth_spinner.hide()
        self.stack.set_visible_child_name("auth")
        self.cc.set_detail_keyboard(True)
        if self._auth_ssid_entry is not None:
            self._auth_ssid_entry.grab_focus()
        else:
            self._auth_password_entry.grab_focus()

    def _show_enterprise(self, ssid: str) -> None:
        clear_box(self.auth_page)
        title = Gtk.Label(label=f"Join “{ssid}”")
        title.set_name("cc-detail-title")
        title.set_xalign(0.0)
        title.set_line_wrap(True)
        self.auth_page.pack_start(title, False, False, 0)

        info = Gtk.Label(
            label=(
                "This network uses enterprise (802.1X) authentication, which "
                "needs a username or certificate.\n\n"
                "Open the network editor to enter those credentials, then "
                "reconnect here."
            )
        )
        info.set_name("cc-sub")
        info.set_xalign(0.0)
        info.set_line_wrap(True)
        self.auth_page.pack_start(info, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cancel = Gtk.Button(label="Cancel")
        cancel.set_name("cc-pill")
        cancel.set_relief(Gtk.ReliefStyle.NONE)
        cancel.connect("clicked", lambda *_: self._cancel_auth())
        actions.pack_end(cancel, False, False, 0)

        editor = Gtk.Button(label="Open Network Editor")
        editor.set_name("cc-primary")
        editor.set_relief(Gtk.ReliefStyle.NONE)
        editor.connect(
            "clicked",
            lambda *_: (
                spawn("nm-connection-editor"),
                self._show_list_page(),
            ),
        )
        actions.pack_end(editor, False, False, 0)
        self.auth_page.pack_end(actions, False, False, 0)

        self.auth_page.show_all()
        self.stack.set_visible_child_name("auth")
        self.cc.set_detail_keyboard(True)

    def _set_auth_error(self, message: str) -> None:
        self._auth_error.set_text(message)
        self._auth_error.show()

    def _cancel_auth(self) -> None:
        self._set_auth_busy(False)
        self._show_list_page()

    def _set_auth_busy(self, busy: bool) -> None:
        self._auth_busy = busy
        join = getattr(self, "_auth_join", None)
        spinner = getattr(self, "_auth_spinner", None)
        if join is not None:
            join.set_sensitive(not busy)
        if spinner is not None:
            if busy:
                spinner.show()
                spinner.start()
            else:
                spinner.stop()
                spinner.hide()

    def _submit_auth(self) -> None:
        if self._auth_busy:
            return
        ssid = self._auth_ssid
        if self._auth_hidden:
            ssid = self._auth_ssid_entry.get_text().strip()
            if not ssid:
                self._set_auth_error("Enter the network name")
                return
        password = self._auth_password_entry.get_text()
        if self._auth_security and not password and not self._auth_hidden:
            self._set_auth_error("Enter the password")
            return

        self._auth_error.hide()
        self._set_auth_busy(True)
        saved = False
        if not self._auth_hidden:
            saved = ssid in saved_wifi_profiles() and not password
        self._connect_wifi(
            ssid,
            password=password,
            saved=saved,
            hidden=self._auth_hidden,
        )
        # The action callback re-enables the form on failure.

    # -- misc ---------------------------------------------------------

    def focus_first(self) -> None:
        if self.stack.get_visible_child_name() == "auth":
            if self._auth_ssid_entry is not None:
                self._auth_ssid_entry.grab_focus()
            else:
                self._auth_password_entry.grab_focus()
        else:
            self.power_switch.grab_focus()


class ControlCenter(Gtk.Window):
    def __init__(self, initial_panel: str | None = None) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_accept_focus(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)

        self.theme = load_theme_colors()
        self.state: dict = {}
        self._refresh_running = False
        self._detail_mode: str | None = None
        self._pending_detail: str | None = initial_panel
        self.detail: ConnectionDetail | None = None
        self._bright_dragging = False
        self._vol_dragging = False

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 54)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, 14)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        GtkLayerShell.set_namespace(self, "bitbeast-cc")

        self._build_css()
        self._build_ui()

        self.connect("key-press-event", self._on_key)
        self.connect("delete-event", self._on_delete)
        self.connect("destroy", self._on_destroy)

        # When launched from the Waybar Wi-Fi/Bluetooth icons, build the detail
        # card before the window is mapped so it appears at its full width on
        # the first frame instead of growing out of a squeezed layout.
        if initial_panel:
            self.open_detail(initial_panel)

        self.show_all()
        self.refresh_states()
        GLib.timeout_add(2500, self.refresh_states)

