    def _build_css(self) -> None:
        css = self._css_text()
        provider = getattr(self, "_css_provider", None)
        if provider is not None:
            try:
                Gtk.StyleContext.remove_provider_for_screen(
                    Gdk.Screen.get_default(), provider
                )
            except Exception:
                pass
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode("utf-8"))
        self._css_provider = provider
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    # -- widget helpers ------------------------------------------------

    def _card(self, vertical: bool = True) -> Gtk.Box:
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
            spacing=8,
        )
        box.set_name("cc-card")
        return box

    def _row(self, icon: str, title: str, on_click):
        ev = Gtk.EventBox()
        ev.set_name("cc-row")
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        ibox = Gtk.Box()
        ibox.set_name("cc-icon-box")
        ibox.set_valign(Gtk.Align.CENTER)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-icon")
        ilab.set_halign(Gtk.Align.CENTER)
        ilab.set_valign(Gtk.Align.CENTER)
        ibox.pack_start(ilab, True, True, 0)
        h.pack_start(ibox, False, False, 0)

        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mid.set_valign(Gtk.Align.CENTER)
        tlab = Gtk.Label(label=title)
        tlab.set_name("cc-title")
        tlab.set_halign(Gtk.Align.START)
        mid.pack_start(tlab, False, False, 0)
        slab = Gtk.Label(label="…")
        slab.set_name("cc-sub")
        slab.set_halign(Gtk.Align.START)
        slab.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(slab, False, False, 0)
        h.pack_start(mid, True, True, 0)

        chev = Gtk.Label(label=I_CHEVRON_RIGHT)
        chev.set_name("cc-chev")
        chev.set_valign(Gtk.Align.CENTER)
        h.pack_start(chev, False, False, 0)

        ev.add(h)
        if on_click:
            ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, tlab, slab, chev

    def _tile(self, icon: str, label: str, on_click):
        ev = Gtk.EventBox()
        ev.set_name("cc-tile")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-icon")
        v.pack_start(ilab, False, False, 0)
        lab = Gtk.Label(label=label)
        lab.set_name("cc-sub")
        lab.set_justify(Gtk.Justification.CENTER)
        v.pack_start(lab, False, False, 0)
        ev.add(v)
        ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, lab

    # -- build ----------------------------------------------------------

    def _build_ui(self) -> None:
        self.root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        panel.set_name("cc-panel")
        panel.set_size_request(470, -1)

        # ── Row 1: connectivity | (dnd + capture) ──
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        conn = self._card()
        self.wifi_row, self.wifi_title, self.wifi_sub, self.wifi_chev = self._row(
            I_WIFI, "Wi-Fi", lambda: self.toggle_detail("wifi")
        )
        self.bt_row, self.bt_title, self.bt_sub, self.bt_chev = self._row(
            I_BLUETOOTH, "Bluetooth", lambda: self.toggle_detail("bluetooth")
        )
        self.pw_row, self.pw_title, self.pw_sub, self.pw_chev = self._row(
            I_POWER, "Power Mode", power_cycle
        )
        for r in (self.wifi_row, self.bt_row, self.pw_row):
            conn.pack_start(r, False, False, 0)
        top.pack_start(conn, True, True, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        dnd_outer = Gtk.EventBox()
        self.dnd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.dnd_box.set_name("cc-big-toggle")
        dlab = Gtk.Label(label="󰂛")
        dlab.set_name("cc-icon")
        dlab.set_valign(Gtk.Align.CENTER)
        self.dnd_box.pack_start(dlab, False, False, 4)
        dtext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        dt1 = Gtk.Label(label="Do Not")
        dt2 = Gtk.Label(label="Disturb")
        for w in (dt1, dt2):
            w.set_name("cc-title")
            w.set_halign(Gtk.Align.START)
            dtext.pack_start(w, False, False, 0)
        self.dnd_box.pack_start(dtext, True, True, 0)
        dnd_outer.add(self.dnd_box)
        dnd_outer.connect("button-press-event", lambda w, e: dnd_toggle() or True)
        set_hand_cursor(dnd_outer)
        right.pack_start(dnd_outer, False, False, 0)
        self.dnd_outer = dnd_outer

        cap = self._card(vertical=False)
        cap.set_homogeneous(True)
        shot_ev, _ = self._tile("󰄀", "Screen\nshot", screenshot)
        self.rec_ev, self.rec_lab = self._tile("󰑊", "Screen\nRecord", self._on_record)
        cap.pack_start(shot_ev, True, True, 0)
        cap.pack_start(self.rec_ev, True, True, 0)
        right.pack_start(cap, True, True, 0)

        top.pack_start(right, True, True, 0)
        panel.pack_start(top, False, False, 0)

        # ── System theme ──
        theme_card = self._card()
        ttitle = Gtk.Label(label="System Theme")
        ttitle.set_name("cc-card-title")
        ttitle.set_halign(Gtk.Align.START)
        theme_card.pack_start(ttitle, False, False, 0)
        self.theme_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.theme_box.set_halign(Gtk.Align.CENTER)
        theme_card.pack_start(self.theme_box, False, False, 0)
        self._build_theme_circles()
        panel.pack_start(theme_card, False, False, 0)

        # ── Brightness ──
        bright_card = self._card()
        btitle = Gtk.Label(label="Brightness")
        btitle.set_name("cc-card-title")
        btitle.set_halign(Gtk.Align.START)
        bright_card.pack_start(btitle, False, False, 0)
        brow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bicon = Gtk.Label(label="󰃟")
        bicon.set_name("cc-icon")
        bicon.set_valign(Gtk.Align.CENTER)
        brow.pack_start(bicon, False, False, 0)
        self.bright_scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 1, 100, 1
        )
        self.bright_scale.set_draw_value(False)
        self.bright_scale.set_value(get_brightness())
        self.bright_scale.connect("button-press-event", self._bright_press)
        self.bright_scale.connect("button-release-event", self._bright_release)
        self.bright_scale.connect(
            "value-changed",
            lambda s: set_brightness(int(s.get_value()))
            if not self._bright_dragging else None,
        )
        brow.pack_start(self.bright_scale, True, True, 0)
        bright_card.pack_start(brow, False, False, 0)
        panel.pack_start(bright_card, False, False, 0)

        # ── Volume ──
        vol_card = self._card()
        vtitle = Gtk.Label(label="Volume")
        vtitle.set_name("cc-card-title")
        vtitle.set_halign(Gtk.Align.START)
        vol_card.pack_start(vtitle, False, False, 0)
        vrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.vol_icon = Gtk.Label(label="󰕾")
        self.vol_icon.set_name("cc-icon")
        self.vol_icon.set_valign(Gtk.Align.CENTER)
        vrow.pack_start(self.vol_icon, False, False, 0)
        self.vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol_scale.set_draw_value(False)
        self.vol_scale.set_value(get_volume())
        self.vol_scale.connect("button-press-event", self._vol_press)
        self.vol_scale.connect("button-release-event", self._vol_release)
        self.vol_scale.connect(
            "value-changed",
            lambda s: set_volume(int(s.get_value()))
            if not self._vol_dragging else None,
        )
        vrow.pack_start(self.vol_scale, True, True, 0)
        vol_card.pack_start(vrow, False, False, 0)
        panel.pack_start(vol_card, False, False, 0)

        self.root.pack_start(panel, False, False, 0)
        self.add(self.root)

    def _bright_press(self, *_a) -> bool:
        self._bright_dragging = True
        return False

    def _bright_release(self, *_a) -> bool:
        self._bright_dragging = False
        set_brightness(int(self.bright_scale.get_value()))
        return False

    def _vol_press(self, *_a) -> bool:
        self._vol_dragging = True
        return False

    def _vol_release(self, *_a) -> bool:
        self._vol_dragging = False
        set_volume(int(self.vol_scale.get_value()))
        return False

    def _on_record(self) -> None:
        screen_record()
        GLib.timeout_add(300, self.refresh_states)

    # -- theme circles --------------------------------------------------

    def _build_theme_circles(self) -> None:
        for child in self.theme_box.get_children():
            self.theme_box.remove(child)
        current = current_beast_theme()
        for name, primary, accent in list_beast_themes():
            ev = Gtk.EventBox()
            ev.set_valign(Gtk.Align.START)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            circ = Gtk.Box()
            ctx = circ.get_style_context()
            if name == current:
                circ.set_name("cc-circle-active")
            else:
                circ.set_name("cc-circle")
                css = f"""
                #cc-circle-{name} {{
                    background-image: linear-gradient(135deg, {primary}, {accent});
                }}
                """
                prov = Gtk.CssProvider()
                prov.load_from_data(css.encode("utf-8"))
                ctx.add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                ctx.add_class(f"cc-circle-{name}")
            gl = Gtk.Label(label="")
            gl.set_name("cc-icon")
            circ.pack_start(gl, True, True, 0)
            circ.set_size_request(46, 46)
            v.pack_start(circ, False, False, 0)
            lab = Gtk.Label(label=name[:9])
            lab.set_name("cc-circle-label")
            v.pack_start(lab, False, False, 0)
            ev.add(v)

            def make_click(theme_name: str):
                def handler(_w, _e):
                    spawn(f"$HOME/.local/bin/bitbeast {theme_name}")
                    GLib.timeout_add(1200, self._on_theme_switched)
                    return True
                return handler

            ev.connect("button-press-event", make_click(name))
            set_hand_cursor(ev)
            self.theme_box.pack_start(ev, False, False, 0)
        self.theme_box.show_all()

    def _rebuild_themes(self) -> bool:
        self._build_theme_circles()
        return False

    def _on_theme_switched(self) -> bool:
        """Recolor the panel and re-highlight circles after a theme switch."""
        self.theme = load_theme_colors()
        self._build_css()
        self._build_theme_circles()
        return False

    # -- detail panel ---------------------------------------------------

    def toggle_detail(self, mode: str) -> None:
        if self._detail_mode == mode and self.detail is not None:
            self.close_detail()
        else:
            self.open_detail(mode)

    def open_detail(self, mode: str) -> None:
        debug(f"open_detail {mode}")
        if mode not in ("wifi", "bluetooth"):
            return
        self._pending_detail = None
        if self._detail_mode == mode and self.detail is not None:
            return

        if self.detail is None:
            self.detail = ConnectionDetail(self)
            self.root.pack_start(self.detail, False, False, 0)
            self.root.reorder_child(self.detail, 0)

        self._detail_mode = mode
        self.detail.set_mode(mode)
        self.detail.show_all()
        self._highlight_rows()
        self.queue_resize()
        self.refresh_states()
        GLib.timeout_add(80, self._resize_to_content)

    def close_detail(self) -> None:
        if self.detail is None:
            return
        self._detail_mode = None
        self.detail.hide()
        self.set_detail_keyboard(False)
        self._highlight_rows()
        self.queue_resize()
        GLib.timeout_add(80, self._resize_to_content)

    def _resize_to_content(self) -> bool:
        # Layer-shell surfaces are not user-resizable; queueing a resize makes
        # GTK recompute the natural width after the detail card is shown/hidden.
        self.queue_resize()
        return False

    def set_detail_keyboard(self, exclusive: bool) -> None:
        try:
            GtkLayerShell.set_keyboard_mode(
                self,
                GtkLayerShell.KeyboardMode.EXCLUSIVE
                if exclusive
                else GtkLayerShell.KeyboardMode.ON_DEMAND,
            )
        except Exception:
            pass

    def _highlight_rows(self) -> None:
        self.wifi_row.set_name(
            "cc-row-active" if self._detail_mode == "wifi" else "cc-row"
        )
        self.bt_row.set_name(
            "cc-row-active" if self._detail_mode == "bluetooth" else "cc-row"
        )
        self.wifi_chev.set_text(
            I_CHEVRON_LEFT if self._detail_mode == "wifi" else I_CHEVRON_RIGHT
        )
        self.bt_chev.set_text(
            I_CHEVRON_LEFT if self._detail_mode == "bluetooth" else I_CHEVRON_RIGHT
        )

    # -- refresh ---------------------------------------------------------

    def refresh_states(self) -> bool:
        if self._refresh_running:
            return True
        self._refresh_running = True
        mode = self._detail_mode or self._pending_detail

        def work():
            try:
                state = {
                    "wifi_available": wifi_available(),
                    "wifi_on": wifi_radio_on(),
                    "wifi_name": wifi_current_name(),
                    "bt_available": bt_available(),
                    "bt_on": bt_powered(),
                    "bt_names": bt_connected_names(),
                    "power": power_profile(),
                    "dnd": dnd_state(),
                    "recording": recording_active(),
                    "brightness": get_brightness(),
                    "volume": get_volume(),
                }
                if state["wifi_on"]:
                    state["wifi_name"] = state["wifi_name"] or ""
                if mode == "wifi":
                    state["networks"] = (
                        wifi_networks(rescan=False) if state["wifi_on"] else []
                    )
                elif mode == "bluetooth":
                    state["devices"] = bt_devices() if state["bt_on"] else []
                return state
            except Exception:
                return {}

        def done(state):
            self._refresh_running = False
            if state:
                self._apply_state(state)
            return False

        threading.Thread(
            target=lambda: GLib.idle_add(done, work()), daemon=True
        ).start()
        return True

    def _apply_state(self, state: dict) -> None:
        self.state = state

        wifi_on = bool(state.get("wifi_on"))
        wifi_available = state.get("wifi_available", True)
        wifi_name = state.get("wifi_name", "")
        if not wifi_available:
            self.wifi_sub.set_text("NetworkManager unavailable")
        elif not wifi_on:
            self.wifi_title.set_text("Wi-Fi")
            self.wifi_sub.set_text("Off")
        else:
            self.wifi_title.set_text("Wi-Fi")
            self.wifi_sub.set_text(wifi_name or "Not connected")

        bt_on = bool(state.get("bt_on"))
        bt_available_ = state.get("bt_available", True)
        bt_names = state.get("bt_names") or []
        if not bt_available_:
            self.bt_sub.set_text("BlueZ unavailable")
        elif not bt_on:
            self.bt_title.set_text("Bluetooth")
            self.bt_sub.set_text("Off")
        else:
            self.bt_title.set_text("Bluetooth")
            if len(bt_names) > 1:
                self.bt_sub.set_text(f"{len(bt_names)} devices")
            else:
                self.bt_sub.set_text(bt_names[0] if bt_names else "On")

        self.pw_sub.set_text(str(state.get("power", "balanced")).capitalize())

        dnd = bool(state.get("dnd"))
        self.dnd_box.set_name("cc-big-active" if dnd else "cc-big-toggle")
        self.dnd_outer.queue_draw()

        rec = bool(state.get("recording"))
        self.rec_lab.set_text("Stop\nRec" if rec else "Screen\nRecord")
        self.rec_lab.get_style_context().remove_class("cc-rec")
        if rec:
            self.rec_lab.get_style_context().add_class("cc-rec")

        if not self._bright_dragging:
            self.bright_scale.set_value(int(state.get("brightness", 50)))
        vol = int(state.get("volume", 0))
        if not self._vol_dragging:
            self.vol_scale.set_value(vol)
        self.vol_icon.set_text(
            "󰝟" if vol == 0 else ("󰕿" if vol < 34 else ("󰖀" if vol < 67 else "󰕾"))
        )

        if self.detail is not None and self.detail.get_visible():
            self.detail.apply_state(state)

    # -- events -----------------------------------------------------------

    def _on_key(self, _w, event) -> bool:
        debug(f"key press {event.keyval}")
        if event.keyval == Gdk.KEY_Escape:
            if (
                self.detail is not None
                and self.detail.get_visible()
                and self.detail.auth_open()
            ):
                self.detail._cancel_auth()
            elif self._detail_mode:
                self.close_detail()
            else:
                self.close()
            return True
        return False

    def _on_delete(self, *_a) -> bool:
        debug("delete-event")
        return False

    def close(self) -> None:
        debug("close() called")
        super().close()

    def handle_command(self, line: str) -> None:
        line = line.strip().lower()
        debug(f"command: {line!r}")
        if not line:
            return
        if line in {"quit", "exit", "close"}:
            self.close()
        elif line in {"toggle"}:
            self.close()
        elif line in {"open", "show"}:
            pass
        elif line in {"open wifi", "show wifi", "wifi"}:
            self.open_detail("wifi")
        elif line in {"open bluetooth", "show bluetooth", "bluetooth", "bt"}:
            self.open_detail("bluetooth")
        elif line in {"close details", "close detail"}:
            self.close_detail()

    def _on_destroy(self, *_a) -> None:
        debug("window destroy")
        try:
            SOCKET_PATH.unlink()
        except Exception:
            pass
        try:
            if PID_FILE.exists() and PID_FILE.read_text().strip() == str(os.getpid()):
                PID_FILE.unlink()
        except Exception:
            pass
        Gtk.main_quit()


def start_server(win: ControlCenter) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    SOCKET_PATH.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    server.bind(str(SOCKET_PATH))
    server.setblocking(False)
    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")

    def on_readable(_fd, _cond):
        while True:
            try:
                data, _ = server.recvfrom(512)
            except Exception:
                break
            win.handle_command(data.decode("utf-8", errors="ignore"))
        return True

    GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_readable)


def usage() -> None:
    print(
        "Usage: bitbeast-control-center [show|toggle|close] "
        "[wifi|bluetooth]"
    )


def main() -> None:
    args = [a.lower() for a in sys.argv[1:]]
    if any(a in {"-h", "--help"} for a in args):
        usage()
        return

    action = "toggle"
    panel: str | None = None
    for arg in args:
        if arg in {"show", "toggle", "close"}:
            action = arg
        elif arg in {"wifi", "wi-fi"}:
            panel = "wifi"
        elif arg in {"bluetooth", "bt"}:
            panel = "bluetooth"

    if action == "close":
        send_command("close")
        return

    message = action
    if panel:
        message = f"open {panel}"
    if send_command(message):
        return

    if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("DISPLAY"):
        print("No display available for control center", file=sys.stderr)
        return

    def on_signal(signum, _frame):
        debug(f"signal {signum}")
        Gtk.main_quit()

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    debug("starting main loop")
    win = ControlCenter(initial_panel=panel)
    start_server(win)
    Gtk.main()
    debug("main loop ended")


if __name__ == "__main__":
    main()
