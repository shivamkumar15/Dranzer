    def _build_css(self) -> None:
        css = self._css_text()
        provider = getattr(self, "_css_provider", None)
        if provider is not None:
            try:
                Gtk.StyleContext.remove_provider_for_screen(
                    Gdk.Screen.get_default(), provider
                )
            except Exception:
                pass
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode("utf-8"))
        self._css_provider = provider
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    # -- widget helpers ------------------------------------------------

    def _card(self, vertical: bool = True) -> Gtk.Box:
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
            spacing=8,
        )
        box.set_name("cc-card")
        return box

    def _row(self, icon: str, title: str, on_click, right_widget=None):
        ev = Gtk.EventBox()
        ev.set_name("cc-row")
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)

        ibox = Gtk.Box()
        ibox.set_name("cc-icon-box")
        ibox.set_valign(Gtk.Align.CENTER)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-icon")
        ilab.set_halign(Gtk.Align.CENTER)
        ilab.set_valign(Gtk.Align.CENTER)
        ibox.pack_start(ilab, True, True, 0)
        h.pack_start(ibox, False, False, 0)

        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mid.set_valign(Gtk.Align.CENTER)
        tlab = Gtk.Label(label=title)
        tlab.set_name("cc-title")
        tlab.set_halign(Gtk.Align.START)
        mid.pack_start(tlab, False, False, 0)
        slab = Gtk.Label(label="…")
        slab.set_name("cc-sub")
        slab.set_halign(Gtk.Align.START)
        slab.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(slab, False, False, 0)
        h.pack_start(mid, True, True, 0)

        if right_widget is not None:
            h.pack_start(right_widget, False, False, 0)

        chev = Gtk.Label(label=I_CHEVRON_RIGHT)
        chev.set_name("cc-chev")
        chev.set_valign(Gtk.Align.CENTER)
        h.pack_start(chev, False, False, 0)

        ev.add(h)
        if on_click:
            ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, tlab, slab, chev

    def _device_row(self, icon: str, title: str, on_click, on_toggle):
        """Connection row with an inline power switch and a details chevron."""
        ev = Gtk.EventBox()
        ev.set_name("cc-row")
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        ibox = Gtk.Box()
        ibox.set_name("cc-icon-box")
        ibox.set_valign(Gtk.Align.CENTER)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-icon")
        ilab.set_halign(Gtk.Align.CENTER)
        ilab.set_valign(Gtk.Align.CENTER)
        ibox.pack_start(ilab, True, True, 0)
        h.pack_start(ibox, False, False, 0)

        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mid.set_valign(Gtk.Align.CENTER)
        tlab = Gtk.Label(label=title)
        tlab.set_name("cc-title")
        tlab.set_halign(Gtk.Align.START)
        mid.pack_start(tlab, False, False, 0)
        slab = Gtk.Label(label="…")
        slab.set_name("cc-sub")
        slab.set_halign(Gtk.Align.START)
        slab.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(slab, False, False, 0)
        h.pack_start(mid, True, True, 0)

        switch = Gtk.Switch()
        switch.set_valign(Gtk.Align.CENTER)
        switch.set_tooltip_text(f"Turn {title} on or off")
        switch.connect("notify::active", lambda sw, _p: on_toggle(bool(sw.get_active())))
        h.pack_start(switch, False, False, 0)

        chev = Gtk.Label(label=I_CHEVRON_RIGHT)
        chev.set_name("cc-chev")
        chev.set_valign(Gtk.Align.CENTER)
        h.pack_start(chev, False, False, 0)

        ev.add(h)
        ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, tlab, slab, switch, chev

    def _tile(self, icon: str, label: str, on_click):
        ev = Gtk.EventBox()
        ev.set_name("cc-capture-tile")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-icon")
        v.pack_start(ilab, False, False, 0)
        lab = Gtk.Label(label=label)
        lab.set_name("cc-capture-label")
        lab.set_justify(Gtk.Justification.CENTER)
        v.pack_start(lab, False, False, 0)
        ev.add(v)
        ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, lab

    def _icon_button(self, icon: str, name: str, on_click, tooltip: str = ""):
        ev = Gtk.EventBox()
        ev.set_name(name)
        if tooltip:
            ev.set_tooltip_text(tooltip)
        lab = Gtk.Label(label=icon)
        lab.set_name("cc-icon")
        lab.set_halign(Gtk.Align.CENTER)
        lab.set_valign(Gtk.Align.CENTER)
        ev.add(lab)
        ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, lab

    def _quick_tile(self, icon: str, label: str, sub: str, on_click):
        ev = Gtk.EventBox()
        ev.set_name("cc-quick-tile")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-quick-icon")
        v.pack_start(ilab, False, False, 0)
        lab = Gtk.Label(label=label)
        lab.set_name("cc-quick-label")
        lab.set_justify(Gtk.Justification.CENTER)
        v.pack_start(lab, False, False, 0)
        slab = Gtk.Label(label=sub)
        slab.set_name("cc-quick-sub")
        slab.set_justify(Gtk.Justification.CENTER)
        v.pack_start(slab, False, False, 0)
        ev.add(v)
        ev.connect("button-press-event", lambda w, e: on_click() or True)
        set_hand_cursor(ev)
        return ev, lab, slab

    # -- right column: clock, notifications, media, session ------------

    def _build_clock_card(self) -> Gtk.Box:
        card = self._card()

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.clock_label = Gtk.Label(label=time.strftime("%H:%M"))
        self.clock_label.set_name("cc-clock")
        self.clock_label.set_halign(Gtk.Align.START)
        self.clock_label.set_valign(Gtk.Align.START)
        head.pack_start(self.clock_label, True, True, 0)

        meta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        meta.set_valign(Gtk.Align.END)
        self.greeting_label = Gtk.Label(label=greeting())
        self.greeting_label.set_name("cc-greeting")
        self.greeting_label.set_halign(Gtk.Align.END)
        self.date_label = Gtk.Label(label=time.strftime("%A, %d %B"))
        self.date_label.set_name("cc-date")
        self.date_label.set_halign(Gtk.Align.END)
        meta.pack_start(self.greeting_label, False, False, 0)
        meta.pack_start(self.date_label, False, False, 0)
        head.pack_end(meta, False, False, 0)
        card.pack_start(head, False, False, 0)

        stats = Gtk.Grid()
        stats.set_name("cc-stats")
        stats.set_row_spacing(2)
        stats.set_column_spacing(2)
        stats.set_column_homogeneous(True)
        stats.set_row_homogeneous(True)
        self.stat_labels: dict[str, Gtk.Label] = {}
        self.stat_bars: dict[str, Gtk.ProgressBar] = {}
        self.stat_icons: dict[str, Gtk.Label] = {}
        for index, (key, icon) in enumerate((
            ("CPU", I_CHIP),
            ("RAM", I_MEMORY),
            ("Disk", I_DISK),
            ("BAT", I_BATTERY),
        )):
            metric = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            metric.set_name("cc-metric")
            metric_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            icon_label = Gtk.Label(label=icon)
            icon_label.set_name("cc-metric-icon")
            icon_label.set_valign(Gtk.Align.CENTER)
            self.stat_icons[key] = icon_label
            name_label = Gtk.Label(label=key.upper())
            name_label.set_name("cc-metric-head")
            name_label.set_valign(Gtk.Align.CENTER)
            metric_head.pack_start(icon_label, False, False, 0)
            metric_head.pack_start(name_label, True, True, 0)
            value_label = Gtk.Label(label="—")
            value_label.set_name("cc-metric-value")
            value_label.set_halign(Gtk.Align.END)
            value_label.set_valign(Gtk.Align.CENTER)
            metric_head.pack_end(value_label, False, False, 0)
            metric.pack_start(metric_head, False, False, 0)
            bar = Gtk.ProgressBar()
            bar.set_name("cc-metric-bar")
            bar.set_show_text(False)
            bar.set_fraction(0.0)
            metric.pack_start(bar, False, False, 0)
            self.stat_labels[key] = value_label
            self.stat_bars[key] = bar
            stats.attach(metric, index % 2, index // 2, 1, 1)
        card.pack_start(stats, False, False, 0)
        return card

    def _build_notifications_card(self) -> Gtk.Box:
        card = self._card()
        self.notify_badge = Gtk.Label(label="0")
        self.notify_badge.set_name("cc-notify-badge")
        self.notify_badge.set_no_show_all(True)
        row, _title, self.notify_sub, _chev = self._row(
            I_BELL, "Notifications", self._open_notifications, self.notify_badge
        )
        card.pack_start(row, False, False, 0)
        return card

    def _build_media_card(self) -> Gtk.Box:
        card = self._card()

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="Now playing")
        title.set_name("cc-card-title")
        title.set_halign(Gtk.Align.START)
        head.pack_start(title, True, True, 0)
        self.media_source = Gtk.Label(label="")
        self.media_source.set_name("cc-media-source")
        self.media_source.set_halign(Gtk.Align.END)
        head.pack_end(self.media_source, False, False, 0)
        card.pack_start(head, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        art_holder = Gtk.EventBox()
        art_holder.set_name("cc-art")
        art_holder.set_size_request(56, 56)
        art_holder.set_valign(Gtk.Align.CENTER)
        self.art_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.art_content.set_halign(Gtk.Align.CENTER)
        self.art_content.set_valign(Gtk.Align.CENTER)
        art_holder.add(self.art_content)
        self._set_media_art(None)
        body.pack_start(art_holder, False, False, 0)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        info.set_valign(Gtk.Align.CENTER)
        self.media_title = Gtk.Label(label="Nothing playing")
        self.media_title.set_name("cc-media-title")
        self.media_title.set_halign(Gtk.Align.START)
        self.media_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.media_artist = Gtk.Label(label="Start something and it will show up here.")
        self.media_artist.set_name("cc-media-artist")
        self.media_artist.set_halign(Gtk.Align.START)
        self.media_artist.set_ellipsize(Pango.EllipsizeMode.END)
        info.pack_start(self.media_title, False, False, 0)
        info.pack_start(self.media_artist, False, False, 0)
        body.pack_start(info, True, True, 0)
        card.pack_start(body, False, False, 0)

        self.media_progress = Gtk.ProgressBar()
        self.media_progress.set_name("cc-progress")
        card.pack_start(self.media_progress, False, False, 0)

        times = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.media_pos = Gtk.Label(label="0:00")
        self.media_pos.set_name("cc-media-time")
        self.media_pos.set_halign(Gtk.Align.START)
        self.media_dur = Gtk.Label(label="0:00")
        self.media_dur.set_name("cc-media-time")
        self.media_dur.set_halign(Gtk.Align.END)
        times.pack_start(self.media_pos, True, True, 0)
        times.pack_end(self.media_dur, False, False, 0)
        card.pack_start(times, False, False, 0)

        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        controls.set_halign(Gtk.Align.CENTER)
        prev_ev, _pl = self._icon_button(
            I_PREV, "cc-transport", lambda: media_action("previous"), "Previous"
        )
        self.play_ev, self.play_label = self._icon_button(
            I_PLAY, "cc-play-btn", lambda: media_action("play-pause"), "Play / Pause"
        )
        next_ev, _nl = self._icon_button(
            I_NEXT, "cc-transport", lambda: media_action("next"), "Next"
        )
        for widget in (prev_ev, self.play_ev, next_ev):
            controls.pack_start(widget, False, False, 0)
        card.pack_start(controls, False, False, 0)
        return card

    def _build_quick_card(self) -> Gtk.Box:
        card = self._card()

        title = Gtk.Label(label="Quick actions")
        title.set_name("cc-card-title")
        title.set_halign(Gtk.Align.START)
        card.pack_start(title, False, False, 0)

        tiles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        tiles.set_homogeneous(True)
        self.airplane_tile, self.airplane_label, self.airplane_sub = self._quick_tile(
            I_AIRPLANE, "Airplane", "Off", self._on_airplane
        )
        net_tile, _nlab, _nsub = self._quick_tile(
            I_SETTINGS, "Network", "Settings", self._open_network_settings
        )
        lock_tile, _llab, _lsub = self._quick_tile(
            I_LOCK_SMALL, "Lock", "Screen", self._lock_screen
        )
        tiles.pack_start(self.airplane_tile, True, True, 0)
        tiles.pack_start(net_tile, True, True, 0)
        tiles.pack_start(lock_tile, True, True, 0)
        card.pack_start(tiles, False, False, 0)
        return card

    def _session_button(self, icon: str, label: str, action: str, danger: bool = False):
        ev = Gtk.EventBox()
        ev.set_name("cc-session-danger" if danger else "cc-session-btn")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_halign(Gtk.Align.CENTER)
        ilab = Gtk.Label(label=icon)
        ilab.set_name("cc-danger-icon" if danger else "cc-icon")
        ilab.set_valign(Gtk.Align.CENTER)
        tlab = Gtk.Label(label=label)
        tlab.set_name("cc-danger-label" if danger else "cc-title")
        tlab.set_valign(Gtk.Align.CENTER)
        box.pack_start(ilab, False, False, 0)
        box.pack_start(tlab, False, False, 0)
        ev.add(box)
        ev.connect(
            "button-press-event", lambda w, e: self._session_action(action) or True
        )
        set_hand_cursor(ev)
        return ev

    def _build_session_card(self) -> Gtk.Box:
        card = self._card()

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="Session")
        title.set_name("cc-card-title")
        title.set_halign(Gtk.Align.START)
        head.pack_start(title, True, True, 0)
        user = Gtk.Label(label=os.environ.get("USER", ""))
        user.set_name("cc-sub")
        user.set_halign(Gtk.Align.END)
        head.pack_end(user, False, False, 0)
        card.pack_start(head, False, False, 0)

        grid = Gtk.Grid()
        grid.set_row_spacing(8)
        grid.set_column_spacing(8)
        grid.set_column_homogeneous(True)
        grid.attach(self._session_button(I_SUSPEND, "Sleep", "suspend"), 0, 0, 1, 1)
        grid.attach(self._session_button(I_LOGOUT, "Log out", "logout"), 1, 0, 1, 1)
        grid.attach(self._session_button(I_RESTART, "Restart", "reboot"), 0, 1, 1, 1)
        grid.attach(
            self._session_button(I_SHUTDOWN, "Shut down", "shutdown", danger=True),
            1, 1, 1, 1,
        )
        card.pack_start(grid, False, False, 0)
        return card

    def _build_side(self) -> Gtk.Box:
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        side.set_name("cc-panel")
        side.set_size_request(388, -1)
        side.pack_start(self._build_clock_card(), False, False, 0)
        side.pack_start(self._build_notifications_card(), False, False, 0)
        side.pack_start(self._build_media_card(), False, False, 0)
        side.pack_start(self._build_session_card(), False, False, 0)
        return side

    # -- build ----------------------------------------------------------

    def _build_ui(self) -> None:
        self.root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        panel.set_name("cc-panel")
        panel.set_size_request(468, -1)

        # ── Row 1: connectivity | (focus + capture) ──
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        conn = self._card()
        self.wifi_row, self.wifi_title, self.wifi_sub, self.wifi_switch, self.wifi_chev = (
            self._device_row(
                I_WIFI, "Wi-Fi", lambda: self.toggle_detail("wifi"), self._on_wifi_switch
            )
        )
        self.bt_row, self.bt_title, self.bt_sub, self.bt_switch, self.bt_chev = (
            self._device_row(
                I_BLUETOOTH, "Bluetooth", lambda: self.toggle_detail("bluetooth"),
                self._on_bt_switch,
            )
        )
        self.pw_row, self.pw_title, self.pw_sub, self.pw_chev = self._row(
            I_POWER, "Power mode", power_cycle
        )
        for r in (self.wifi_row, self.bt_row, self.pw_row):
            conn.pack_start(r, False, False, 0)
        self.wifi_row.set_tooltip_text("Manage Wi-Fi networks")
        self.bt_row.set_tooltip_text("Manage Bluetooth devices")
        self.pw_row.set_tooltip_text("Click to cycle balanced, performance, and saver")
        top.pack_start(conn, True, True, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        right.set_size_request(176, -1)

        dnd_outer = Gtk.EventBox()
        self.dnd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.dnd_box.set_name("cc-focus")
        dicon = Gtk.Label(label=I_BELL_ON)
        dicon.set_name("cc-focus-icon")
        dicon.set_valign(Gtk.Align.CENTER)
        self.dnd_box.pack_start(dicon, False, False, 0)
        dtext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        dtitle = Gtk.Label(label="Do Not Disturb")
        dtitle.set_name("cc-title")
        dtitle.set_halign(Gtk.Align.START)
        dtext.pack_start(dtitle, False, False, 0)
        self.dnd_sub = Gtk.Label(label="Alerts are on")
        self.dnd_sub.set_name("cc-sub")
        self.dnd_sub.set_halign(Gtk.Align.START)
        dtext.pack_start(self.dnd_sub, False, False, 0)
        self.dnd_box.pack_start(dtext, True, True, 0)
        self.dnd_state = Gtk.Label(label="Off")
        self.dnd_state.set_name("cc-focus-dot")
        self.dnd_state.set_valign(Gtk.Align.CENTER)
        self.dnd_box.pack_end(self.dnd_state, False, False, 0)
        dnd_outer.add(self.dnd_box)
        dnd_outer.connect("button-press-event", lambda w, e: dnd_toggle() or True)
        set_hand_cursor(dnd_outer)
        right.pack_start(dnd_outer, False, False, 0)
        self.dnd_outer = dnd_outer

        cap = self._card(vertical=False)
        cap.set_homogeneous(True)
        shot_ev, _ = self._tile(I_SCREENSHOT, "Screenshot", screenshot)
        self.rec_ev, self.rec_lab = self._tile(I_RECORD, "Record", self._on_record)
        cap.pack_start(shot_ev, True, True, 0)
        cap.pack_start(self.rec_ev, True, True, 0)
        right.pack_start(cap, True, True, 0)

        top.pack_start(right, False, False, 0)
        panel.pack_start(top, False, False, 0)

        # ── Beast theme ──
        theme_card = self._card()
        thead = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        ttitle = Gtk.Label(label="Beast theme")
        ttitle.set_name("cc-card-title")
        ttitle.set_halign(Gtk.Align.START)
        thead.pack_start(ttitle, True, True, 0)
        self.theme_current = Gtk.Label(label="")
        self.theme_current.set_name("cc-theme-current")
        self.theme_current.set_halign(Gtk.Align.END)
        thead.pack_end(self.theme_current, False, False, 0)
        theme_card.pack_start(thead, False, False, 0)
        self.theme_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.theme_box.set_halign(Gtk.Align.CENTER)
        theme_card.pack_start(self.theme_box, False, False, 0)
        self._build_theme_circles()
        panel.pack_start(theme_card, False, False, 0)

        # ── Brightness & volume ──
        slider_card = self._card()
        stitle = Gtk.Label(label="Display & sound")
        stitle.set_name("cc-card-title")
        stitle.set_halign(Gtk.Align.START)
        slider_card.pack_start(stitle, False, False, 0)

        bright_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        bicon = Gtk.Label(label=I_BRIGHTNESS)
        bicon.set_name("cc-slider-icon")
        bright_head.pack_start(bicon, False, False, 0)
        blabel = Gtk.Label(label="Brightness")
        blabel.set_name("cc-slider-head")
        blabel.set_halign(Gtk.Align.START)
        bright_head.pack_start(blabel, True, True, 0)
        self.bright_val = Gtk.Label(label="—")
        self.bright_val.set_name("cc-slider-value")
        bright_head.pack_end(self.bright_val, False, False, 0)
        slider_card.pack_start(bright_head, False, False, 0)
        self.bright_scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 1, 100, 1
        )
        self.bright_scale.set_draw_value(False)
        self.bright_scale.set_value(get_brightness())
        self.bright_scale.connect("button-press-event", self._bright_press)
        self.bright_scale.connect("button-release-event", self._bright_release)
        self.bright_scale.connect(
            "value-changed",
            lambda s: self._on_brightness_changed(int(s.get_value())),
        )
        slider_card.pack_start(self.bright_scale, False, False, 4)

        vol_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        self.vol_icon = Gtk.Label(label=I_VOLUME)
        self.vol_icon.set_name("cc-slider-icon")
        vol_head.pack_start(self.vol_icon, False, False, 0)
        vlabel = Gtk.Label(label="Volume")
        vlabel.set_name("cc-slider-head")
        vlabel.set_halign(Gtk.Align.START)
        vol_head.pack_start(vlabel, True, True, 0)
        self.mute_ev, self.mute_label = self._icon_button(
            I_VOLUME, "cc-mute-btn", self._on_mute, "Mute / Unmute"
        )
        vol_head.pack_end(self.mute_ev, False, False, 0)
        self.vol_val = Gtk.Label(label="—")
        self.vol_val.set_name("cc-slider-value")
        vol_head.pack_end(self.vol_val, False, False, 0)
        slider_card.pack_start(vol_head, False, False, 0)
        self.vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol_scale.set_draw_value(False)
        self.vol_scale.set_value(get_volume())
        self.vol_scale.connect("button-press-event", self._vol_press)
        self.vol_scale.connect("button-release-event", self._vol_release)
        self.vol_scale.connect(
            "value-changed",
            lambda s: self._on_volume_changed(int(s.get_value())),
        )
        slider_card.pack_start(self.vol_scale, False, False, 4)
        panel.pack_start(slider_card, False, False, 0)

        panel.pack_start(self._build_quick_card(), False, False, 0)

        self.root.pack_start(panel, False, False, 0)
        self.side = self._build_side()
        self.root.pack_start(self.side, False, False, 0)
        self.add(self.root)

    def _set_media_art(self, path: str | None) -> None:
        if path == self._art_path:
            return
        self._art_path = path
        for child in self.art_content.get_children():
            self.art_content.remove(child)
            child.destroy()
        pixbuf = rounded_art(path) if path else None
        if pixbuf is not None:
            image = Gtk.Image.new_from_pixbuf(pixbuf)
            image.set_halign(Gtk.Align.CENTER)
            image.set_valign(Gtk.Align.CENTER)
            self.art_content.pack_start(image, True, True, 0)
            self.art_content.set_border_width(0)
        else:
            icon = Gtk.Label(label=I_MUSIC)
            icon.set_name("cc-art-icon")
            icon.set_halign(Gtk.Align.CENTER)
            icon.set_valign(Gtk.Align.CENTER)
            self.art_content.pack_start(icon, True, True, 0)
        self.art_content.show_all()

    def _on_brightness_changed(self, value: int) -> None:
        self.bright_val.set_text(f"{value}%")
        if not self._syncing_sliders and not self._bright_dragging:
            set_brightness(value)

    def _on_volume_changed(self, value: int) -> None:
        self.vol_val.set_text(f"{value}%")
        if not self._syncing_sliders and not self._vol_dragging:
            set_volume(value)

    def _lock_screen(self) -> None:
        spawn("$HOME/.local/bin/bitbeast lock")
        self.close()

    def _on_wifi_switch(self, on: bool) -> None:
        if self._sync_switches:
            return
        self.wifi_sub.set_text("Turning on…" if on else "Turning off…")

        def work():
            result = wifi_set_power(on)
            GLib.idle_add(lambda: self._radio_done(result, self.wifi_sub))

        threading.Thread(target=work, daemon=True).start()

    def _on_bt_switch(self, on: bool) -> None:
        if self._sync_switches:
            return
        self.bt_sub.set_text("Turning on…" if on else "Turning off…")

        def work():
            result = bt_set_power(on)
            GLib.idle_add(lambda: self._radio_done(result, self.bt_sub))

        threading.Thread(target=work, daemon=True).start()

    def _radio_done(self, result, sub_label: Gtk.Label) -> bool:
        ok, message = result
        if not ok:
            sub_label.set_text(message)
        self.refresh_states()
        return False

    def _on_mute(self) -> None:
        toggle_volume_mute()
        GLib.timeout_add(250, self.refresh_live)
        GLib.timeout_add(400, self.refresh_states)

    def _on_airplane(self) -> None:
        toggle_airplane()
        GLib.timeout_add(600, self.refresh_live)
        GLib.timeout_add(900, self.refresh_states)

    def _open_notifications(self) -> None:
        spawn("swaync-client --toggle-panel")
        self.close()

    def _open_network_settings(self) -> None:
        if shutil.which("nm-connection-editor"):
            spawn("nm-connection-editor")
        else:
            spawn("kitty -e nmtui")
        self.close()

    def _session_action(self, action: str) -> None:
        session_action(action)
        self.close()

    def _bright_press(self, *_a) -> bool:
        self._bright_dragging = True
        return False

    def _bright_release(self, *_a) -> bool:
        self._bright_dragging = False
        set_brightness(int(self.bright_scale.get_value()))
        return False

    def _vol_press(self, *_a) -> bool:
        self._vol_dragging = True
        return False

    def _vol_release(self, *_a) -> bool:
        self._vol_dragging = False
        set_volume(int(self.vol_scale.get_value()))
        return False

    def _on_record(self) -> None:
        screen_record()
        GLib.timeout_add(300, self.refresh_states)

    # -- theme circles --------------------------------------------------

    def _build_theme_circles(self) -> None:
        for child in self.theme_box.get_children():
            self.theme_box.remove(child)
        current = current_beast_theme()
        if hasattr(self, "theme_current"):
            self.theme_current.set_text(beast_label(current) if current else "Choose")
        for index, (name, primary, accent) in enumerate(list_beast_themes()):
            ev = Gtk.EventBox()
            ev.set_name("cc-theme-item")
            ev.set_valign(Gtk.Align.START)
            ev.set_tooltip_text(beast_label(name))
            ev.set_size_request(52, -1)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            circ = Gtk.Box()
            circ.set_halign(Gtk.Align.CENTER)
            ctx = circ.get_style_context()
            circ.set_name("cc-theme-swatch-on" if name == current else "cc-theme-swatch")
            css = f"""
            .cc-theme-swatch-{index} {{
                background-image: linear-gradient(135deg, {primary}, {accent});
            }}
            """
            prov = Gtk.CssProvider()
            prov.load_from_data(css.encode("utf-8"))
            ctx.add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            ctx.add_class(f"cc-theme-swatch-{index}")
            gl = Gtk.Label(label="")
            gl.set_name("cc-icon")
            circ.pack_start(gl, True, True, 0)
            circ.set_size_request(30, 30)
            v.pack_start(circ, False, False, 0)
            lab = Gtk.Label(label=beast_short(name))
            lab.set_name("cc-theme-name-on" if name == current else "cc-theme-name")
            lab.set_justify(Gtk.Justification.CENTER)
            v.pack_start(lab, False, False, 0)
            ev.add(v)

            def make_click(theme_name: str):
                def handler(_w, _e):
                    spawn(f"$HOME/.local/bin/bitbeast {theme_name}")
                    GLib.timeout_add(1200, self._on_theme_switched)
                    return True
                return handler

            ev.connect("button-press-event", make_click(name))
            set_hand_cursor(ev)
            self.theme_box.pack_start(ev, False, False, 0)
        self.theme_box.show_all()

    def _rebuild_themes(self) -> bool:
        self._build_theme_circles()
        return False

    def _on_theme_switched(self) -> bool:
        """Recolor the panel and re-highlight circles after a theme switch."""
        self.theme = load_theme_colors()
        self._build_css()
        self._build_theme_circles()
        return False

    # -- detail panel ---------------------------------------------------

    def toggle_detail(self, mode: str) -> None:
        if self._detail_mode == mode and self.detail is not None:
            self.close_detail()
        else:
            self.open_detail(mode)

    def open_detail(self, mode: str) -> None:
        debug(f"open_detail {mode}")
        if mode not in ("wifi", "bluetooth"):
            return
        self._pending_detail = None
        if self._detail_mode == mode and self.detail is not None:
            return

        if self.detail is None:
            self.detail = ConnectionDetail(self)
            self.root.pack_start(self.detail, False, False, 0)
            self.root.reorder_child(self.detail, 0)

        self._detail_mode = mode
        self.detail.set_mode(mode)
        self.detail.show_all()
        self._highlight_rows()
        self.queue_resize()
        self.refresh_states()
        GLib.timeout_add(80, self._resize_to_content)

    def close_detail(self) -> None:
        if self.detail is None:
            return
        self._detail_mode = None
        self.detail.hide()
        self.set_detail_keyboard(False)
        self._highlight_rows()
        self.queue_resize()
        GLib.timeout_add(80, self._resize_to_content)

    def _resize_to_content(self) -> bool:
        # Layer-shell surfaces are not user-resizable; queueing a resize makes
        # GTK recompute the natural width after the detail card is shown/hidden.
        self.queue_resize()
        return False

    def set_detail_keyboard(self, exclusive: bool) -> None:
        try:
            GtkLayerShell.set_keyboard_mode(
                self,
                GtkLayerShell.KeyboardMode.EXCLUSIVE
                if exclusive
                else GtkLayerShell.KeyboardMode.ON_DEMAND,
            )
        except Exception:
            pass

    def _highlight_rows(self) -> None:
        self.wifi_row.set_name(
            "cc-row-active" if self._detail_mode == "wifi" else "cc-row"
        )
        self.bt_row.set_name(
            "cc-row-active" if self._detail_mode == "bluetooth" else "cc-row"
        )
        self.wifi_chev.set_text(
            I_CHEVRON_LEFT if self._detail_mode == "wifi" else I_CHEVRON_RIGHT
        )
        self.bt_chev.set_text(
            I_CHEVRON_LEFT if self._detail_mode == "bluetooth" else I_CHEVRON_RIGHT
        )

    # -- refresh ---------------------------------------------------------

    def refresh_live(self) -> bool:
        """Clock, media, notifications, toggles and system stats (1.5s)."""
        if self._live_running:
            return True
        self._live_running = True

        def work():
            try:
                cpu, self._prev_cpu = cpu_usage_percent(self._prev_cpu)
                battery = battery_status()
                if battery is None:
                    bat_text = "—"
                    charging = False
                else:
                    percent, charging = battery
                    bat_text = f"{percent}%"

                player = get_player()
                return {
                    "clock": time.strftime("%H:%M"),
                    "date": time.strftime("%A, %d %B"),
                    "greeting": greeting(),
                    "notify": notification_summary(),
                    "notify_count": notification_count(),
                    "airplane": airplane_enabled(),
                    "battery_charging": charging,
                    "stats": {
                        "CPU": f"{int(round(cpu))}%",
                        "RAM": f"{ram_usage_percent()}%",
                        "Disk": f"{disk_usage_percent()}%",
                        "BAT": bat_text,
                    },
                    "media": media_state(player) if player else None,
                }
            except Exception:
                return {}

        def done(state):
            self._live_running = False
            if state:
                self._apply_live(state)
            return False

        threading.Thread(
            target=lambda: GLib.idle_add(done, work()), daemon=True
        ).start()
        return True

    def _apply_live(self, state: dict) -> None:
        self.clock_label.set_text(state.get("clock", ""))
        self.greeting_label.set_text(state.get("greeting", greeting()))
        self.date_label.set_text(state.get("date", ""))
        self.notify_sub.set_text(state.get("notify", ""))
        count = int(state.get("notify_count", 0) or 0)
        self.notify_badge.set_text(str(count))
        if count > 0:
            self.notify_badge.show()
        else:
            self.notify_badge.hide()
        self.airplane_tile.set_name(
            "cc-quick-active" if state.get("airplane") else "cc-quick-tile"
        )
        self.airplane_sub.set_text("On" if state.get("airplane") else "Off")
        stats = state.get("stats") or {}
        for key, label in self.stat_labels.items():
            value = stats.get(key, "—")
            label.set_text(value)
            try:
                percent = int(str(value).strip("%"))
            except ValueError:
                percent = 0
            self.stat_bars[key].set_fraction(max(0.0, min(percent / 100.0, 1.0)))
        self.stat_icons["BAT"].set_text(
            I_BATTERY_CHARGING if state.get("battery_charging") else I_BATTERY
        )
        self._apply_media(state.get("media"))

    def _apply_media(self, media: dict | None) -> None:
        if not media:
            self.media_title.set_text("Nothing playing")
            self.media_artist.set_text("Start something and it will show up here.")
            self.media_source.set_text("")
            self.media_progress.set_fraction(0.0)
            self.media_pos.set_text("0:00")
            self.media_dur.set_text("0:00")
            self.play_label.set_text(I_PLAY)
            self._set_media_art(None)
            return

        self.media_title.set_text(media.get("title", "Unknown Track"))
        self.media_artist.set_text(media.get("artist", "Unknown Artist"))
        source = media.get("player_name", "")
        status = media.get("status", "")
        self.media_source.set_text(source.upper() if source else "")
        self.media_progress.set_fraction(float(media.get("fraction", 0.0)))
        position = media.get("position", 0)
        duration = float(media.get("duration", 0) or 0)
        self.media_pos.set_text(fmt_time(position))
        self.media_dur.set_text(fmt_time(duration) if duration > 0 else "LIVE")
        self.play_label.set_text(I_PAUSE if status == "Playing" else I_PLAY)
        self._set_media_art(media.get("art"))

    def refresh_states(self) -> bool:
        if self._refresh_running:
            return True
        self._refresh_running = True
        mode = self._detail_mode or self._pending_detail

        def work():
            try:
                state = {
                    "wifi_available": wifi_available(),
                    "wifi_on": wifi_radio_on(),
                    "wifi_name": wifi_current_name(),
                    "bt_available": bt_available(),
                    "bt_on": bt_powered(),
                    "bt_names": bt_connected_names(),
                    "power": power_profile(),
                    "dnd": dnd_state(),
                    "recording": recording_active(),
                    "brightness": get_brightness(),
                    "volume": get_volume(),
                    "muted": volume_muted(),
                }
                if state["wifi_on"]:
                    state["wifi_name"] = state["wifi_name"] or ""
                if mode == "wifi":
                    state["networks"] = (
                        wifi_networks(rescan=False) if state["wifi_on"] else []
                    )
                elif mode == "bluetooth":
                    state["devices"] = bt_devices() if state["bt_on"] else []
                return state
            except Exception:
                return {}

        def done(state):
            self._refresh_running = False
            if state:
                self._apply_state(state)
            return False

        threading.Thread(
            target=lambda: GLib.idle_add(done, work()), daemon=True
        ).start()
        return True

    def _apply_state(self, state: dict) -> None:
        self.state = state

        wifi_on = bool(state.get("wifi_on"))
        wifi_available = state.get("wifi_available", True)
        wifi_name = state.get("wifi_name", "")
        if not wifi_available:
            self.wifi_sub.set_text("NetworkManager unavailable")
        elif not wifi_on:
            self.wifi_title.set_text("Wi-Fi")
            self.wifi_sub.set_text("Off")
        else:
            self.wifi_title.set_text("Wi-Fi")
            self.wifi_sub.set_text(wifi_name or "Not connected")

        bt_on = bool(state.get("bt_on"))
        bt_available_ = state.get("bt_available", True)
        bt_names = state.get("bt_names") or []
        if not bt_available_:
            self.bt_sub.set_text("BlueZ unavailable")
        elif not bt_on:
            self.bt_title.set_text("Bluetooth")
            self.bt_sub.set_text("Off")
        else:
            self.bt_title.set_text("Bluetooth")
            if len(bt_names) > 1:
                self.bt_sub.set_text(f"{len(bt_names)} connected")
            else:
                self.bt_sub.set_text(bt_names[0] if bt_names else "On")

        self._sync_switches = True
        try:
            self.wifi_switch.set_sensitive(bool(wifi_available))
            self.wifi_switch.set_active(wifi_on)
            self.bt_switch.set_sensitive(bool(bt_available_))
            self.bt_switch.set_active(bt_on)
        finally:
            self._sync_switches = False

        power = str(state.get("power", "balanced")).lower()
        self.pw_sub.set_text({
            "power-saver": "Battery saver",
            "performance": "Performance",
            "balanced": "Balanced",
        }.get(power, power.replace("-", " ").title()))

        dnd = bool(state.get("dnd"))
        self.dnd_box.set_name("cc-focus-active" if dnd else "cc-focus")
        self.dnd_sub.set_text("Silencing alerts" if dnd else "Alerts are on")
        self.dnd_state.set_text("On" if dnd else "Off")
        self.dnd_outer.queue_draw()

        rec = bool(state.get("recording"))
        self.rec_lab.set_text("Stop" if rec else "Record")
        self.rec_ev.set_name("cc-capture-active" if rec else "cc-capture-tile")
        self.rec_lab.get_style_context().remove_class("cc-rec")
        if rec:
            self.rec_lab.get_style_context().add_class("cc-rec")

        brightness = int(state.get("brightness", 50))
        vol = int(state.get("volume", 0))
        self._syncing_sliders = True
        try:
            if not self._bright_dragging:
                self.bright_scale.set_value(brightness)
            if not self._vol_dragging:
                self.vol_scale.set_value(vol)
        finally:
            self._syncing_sliders = False
        self.bright_val.set_text(f"{brightness}%")
        self.vol_val.set_text(f"{vol}%")
        muted = bool(state.get("muted", vol == 0))
        self.vol_icon.set_text(
            I_MUTE if muted else (I_VOLUME_LOW if vol < 34 else (I_VOLUME_MID if vol < 67 else I_VOLUME))
        )
        self.mute_label.set_text(I_MUTE if muted else I_VOLUME)

        if self.detail is not None and self.detail.get_visible():
            self.detail.apply_state(state)

    # -- events -----------------------------------------------------------

    def _on_key(self, _w, event) -> bool:
        debug(f"key press {event.keyval}")
        if event.keyval == Gdk.KEY_Escape:
            self.dismiss()
            return True
        return False

    def dismiss(self) -> None:
        """Escape behaviour, shared with the click-away backdrop.

        Cancel an open password prompt, else close the Wi-Fi/Bluetooth detail
        popover, else remove the panel itself.
        """
        if (
            self.detail is not None
            and self.detail.get_visible()
            and self.detail.auth_open()
        ):
            self.detail._cancel_auth()
        elif self._detail_mode:
            self.close_detail()
        else:
            self.close()

    def _on_delete(self, *_a) -> bool:
        debug("delete-event")
        return False

    def close(self) -> None:
        debug("close() called")
        super().close()

    def handle_command(self, line: str) -> None:
        line = line.strip().lower()
        debug(f"command: {line!r}")
        if not line:
            return
        if line in {"quit", "exit", "close"}:
            self.close()
        elif line in {"toggle"}:
            self.close()
        elif line in {"open", "show"}:
            pass
        elif line in {"open wifi", "show wifi", "wifi"}:
            self.open_detail("wifi")
        elif line in {"open bluetooth", "show bluetooth", "bluetooth", "bt"}:
            self.open_detail("bluetooth")
        elif line in {"close details", "close detail"}:
            self.close_detail()

    def _on_destroy(self, *_a) -> None:
        debug("window destroy")
        try:
            SOCKET_PATH.unlink()
        except Exception:
            pass
        try:
            if PID_FILE.exists() and PID_FILE.read_text().strip() == str(os.getpid()):
                PID_FILE.unlink()
        except Exception:
            pass
        Gtk.main_quit()


def start_server(win: ControlCenter) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    SOCKET_PATH.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    server.bind(str(SOCKET_PATH))
    server.setblocking(False)
    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")

    def on_readable(_fd, _cond):
        while True:
            try:
                data, _ = server.recvfrom(512)
            except Exception:
                break
            win.handle_command(data.decode("utf-8", errors="ignore"))
        return True

    GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_readable)


def usage() -> None:
    print(
        "Usage: bitbeast-control-center [show|toggle|close] "
        "[wifi|bluetooth]"
    )


def main() -> None:
    args = [a.lower() for a in sys.argv[1:]]
    if any(a in {"-h", "--help"} for a in args):
        usage()
        return

    action = "toggle"
    panel: str | None = None
    for arg in args:
        if arg in {"show", "toggle", "close"}:
            action = arg
        elif arg in {"wifi", "wi-fi"}:
            panel = "wifi"
        elif arg in {"bluetooth", "bt"}:
            panel = "bluetooth"

    if action == "close":
        send_command("close")
        return

    message = action
    if panel:
        message = f"open {panel}"
    if send_command(message):
        return

    if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("DISPLAY"):
        print("No display available for control center", file=sys.stderr)
        return

    def on_signal(signum, _frame):
        debug(f"signal {signum}")
        Gtk.main_quit()

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    debug("starting main loop")
    win = ControlCenter(initial_panel=panel)
    start_server(win)
    Gtk.main()
    debug("main loop ended")


if __name__ == "__main__":
    main()
